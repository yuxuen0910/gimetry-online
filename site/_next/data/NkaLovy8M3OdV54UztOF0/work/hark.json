{"pageProps":{"work":{"_createdAt":"2025-04-28T17:36:11Z","_id":"2e605a85-cdeb-45e7-8f33-ce846797a645","_rev":"h53se4Pc2uw77GU24lWtL2","_system":{"base":{"id":"2e605a85-cdeb-45e7-8f33-ce846797a645","rev":"0kZPXms1Imn9mJJJfpOCoE"}},"_type":"work","_updatedAt":"2026-07-06T18:53:19Z","metaDescription":"A brand sprint for Hark: raw frozen food for dogs.","nextProject":{"_createdAt":"2025-04-30T21:54:19Z","_id":"b5f8b6f5-4dd9-40ff-ab37-ec4cd13415c8","_rev":"tTlXFWaLzsE9XjbfIDbjXk","_system":{"base":{"id":"b5f8b6f5-4dd9-40ff-ab37-ec4cd13415c8","rev":"NMtmX848WKOgxaslcAVumU"}},"_type":"work","_updatedAt":"2026-07-06T18:55:25Z","nextProject":null,"orderRank":"0|10000x:f","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"litquidity"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1082961602","url":"/ext/vimeo-img/2014058196-fd2dc05f5d7b049ea37f73b2fbeb88b01869d8848e3efc3f1169c80388da598b-d.jpg"},"video":"/ext/video/1083700266-720p.mp4","videoAdaptive":null,"vimeoId":"1083700266"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-84544fee89a0fce98fe375dbae3564ed7ae760e2-3840x2560-webp","_type":"reference"}},"mediaType":"image"},"thumbnailExcerpt":"Rebranding the Internet's dankest financial news source.","title":"Litquidity","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ecf1ee"},"heroMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-7433a68b936129250f327db1e23c790951196058-3408x2272-webp","_type":"reference"}},"mediaType":"image"},"sectionContent":[{"_key":"bbae32089c30","_type":"block","children":[{"_key":"e3e410232a970","_type":"span","marks":[],"text":"Litquidity isn’t just a finance meme account, it’s a media powerhouse with over 2.5 million followers, a booming newsletter (ExecSum), a podcast network, and a syndicate of private investors. As their influence grew, so did the need for a cohesive digital identity that matched the sophistication of their content. That's where we came in."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand Identity","Web Design"],"websiteURL":"https://litquidity.co/"},"workModules":[{"_key":"2e8e51dd79f4","_type":"workTextBlock","content":[{"_key":"ec715beb6dbd","_type":"block","children":[{"_key":"86114597c4e60","_type":"span","marks":[],"text":"Gimetry Studio partnered with Litquidity to reimagine their brand system and create a unified web presence, one that balances edge and polish, and gives their content the credibility it deserves. We developed a flexible visual language that could stretch across platforms while still feeling unmistakably “Lit.” Clean typography, an editorial-inspired layout system, and subtle nods to financial vernacular formed the foundation."}],"markDefs":[],"style":"normal"}],"title":"Bringing the market to the masses"},{"_key":"d82f0113f64b","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-a827555afdf55eb678e703117a4deb931187ad54-3840x2161-webp","_type":"reference"}},"mediaType":"video","video":"/ext/video/1081906204-2160p.mp4","videoAdaptive":null}},{"_key":"8e6c63401b34","_type":"workDouble45","leftMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1081906179","url":"/ext/vimeo-img/2012783939-f2e4d896fd3f5c73539820c09b88354146b2f04cd466cb6156d9f73c43a48742-d.jpg"},"video":"/ext/video/1081906179-1440p.mp4","vimeoId":"1081906179"},"rightMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1081906187","url":"/ext/vimeo-img/2012783982-8f1d9fee7466557d2f5dc69797a56a60d7c7de75fa9aee68486431e30523446b-d.jpg"},"video":"/ext/video/1081906187-1440p.mp4","vimeoId":"1081906187"}},{"_key":"3c50f9b7269a","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-066f13f23c4b5d4fcfe1dd66d14f2b7de440d3fd-1728x2160-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1084400436","url":"/ext/vimeo-img/2015808079.jpg"},"video":"/ext/video/1084400436-1440p.mp4","videoAdaptive":null,"vimeoId":"1084400436"}},{"_key":"35dff4f9df97","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-a48dd9f5bc93c81db99f400f2cba5b629891bc26-1728x2160-webp","_type":"reference"}},"mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1082961602","url":"/ext/vimeo-img/2014058196-fd2dc05f5d7b049ea37f73b2fbeb88b01869d8848e3efc3f1169c80388da598b-d.jpg"},"video":"/ext/video/1082961602-1080p.mp4","videoAdaptive":null,"vimeoId":"1082961602"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-a48dd9f5bc93c81db99f400f2cba5b629891bc26-1728x2160-webp","_type":"reference"}},"mediaType":"image"}}]},"orderRank":"0|10000x:d","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"hark"},"thumbnailContent":{"_type":"media","mediaType":"video","video":"/ext/video/1083700247-720p.mp4","videoAdaptive":null,"vimeoId":"1083700247"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-531cae6d4c912f73697b162c28b5234ddccfd70a-3408x2272-webp","_type":"reference"}},"mediaType":"image"},"thumbnailExcerpt":"Design sprint for the most complete raw frozen dog food.","title":"Hark","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ffd3e5"},"buttonColor":"black","heroMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-531cae6d4c912f73697b162c28b5234ddccfd70a-3408x2272-webp","_type":"reference"}},"mediaType":"image"},"sectionContent":[{"_key":"537be6639ff0","_type":"block","children":[{"_key":"45cb1ea5b4ba0","_type":"span","marks":[],"text":"Hark is putting wags into bags, with the only human-grade raw food that's also made with heart-healthy grains and whole ingredients."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand Identity","Website Design"],"textColor":"darkGray"},"workModules":[{"_key":"95a61e1409ee","_type":"workTextBlock","content":[{"_key":"8c3596bb770f","_type":"block","children":[{"_key":"8cbd6d32a802","_type":"span","marks":[],"text":"Hark engaged Gimetry Studio looking for a brand sprint. We try to only do a few of these a year, and only for brands that we think will make them count. In this instance the founding team had clear messaging and a robust internal positioning document, and just needed a quick-to-market identity that would help them establish an initial brand playbook for fundraising. Plus, dogs. Done deal."}],"markDefs":[],"style":"normal"}],"title":"Who's a good brand?"},{"_key":"16a1987b74be632b5a477c3001f20820","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-65c6cba394df84340d98706ad204eb9e7e15db9d-1680x2100-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-cd607650fbb4260e9c4938e665e98a4021631f2a-840x1050-gif","_type":"reference"}},"mediaType":"gif"}},{"_key":"d928fb3ec0b7","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/1079583364-2160p.mp4","videoAdaptive":null,"vimeoId":"1079583364"}},{"_key":"1cc2972247c9","_type":"workTextBlock","content":[{"_key":"2b3b209e1d08","_type":"block","children":[{"_key":"ee2506e01848","_type":"span","marks":[],"text":"As out-and-out dog lovers, the team leapt at the opportunity to unleash on this one. Inspired by the telltale \"clink\" sound of frozen food hitting a dog bowl, we quickly fell in love with the idea of an onomatopoeic brand — one that let us use dynamic typography to emulate happy pups of all types.\n\nIn just under two weeks we had a complete brand toolbox handed over, all within Figma for complete flexibility. The sprint included logos, packaging, photography styles, launch graphics and a one page website homepage."}],"markDefs":[],"style":"normal"}],"title":"A design you can hear"},{"_key":"621e83325fdc","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/1079863100-1440p.mp4","videoAdaptive":null}},{"_key":"e62771345d0a","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-2bbe87b7f637df81f3fe682c0695c4c39a1c253e-1680x2100-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-181bf72daa29a2b46df9fd2cc2aff58f9a2ef842-1680x2100-webp","_type":"reference"}},"mediaType":"image"}}]},"params":{"slug":"hark"},"globalSettings":{"_createdAt":"2024-10-22T20:44:16Z","_id":"globalSettings","_rev":"6p8vZffvPAFD6E6aSNtKo2","_type":"globalSettings","_updatedAt":"2025-04-24T03:14:08Z","footer":{"email":"yuxuen1993@gmail.com","infoPages":[{"_key":"841d1d64f5ea","_type":"pageLink","path":"/careers","title":"Collaborate"},{"_key":"3ffc11fd5737","_type":"pageLink","path":"/contact","title":"Contact Us"}],"phoneNumber":"+60 11-6368 3842","socials":[]}},"draftMode":false,"seo":{"title":"Hark — Gimetry Studio","description":"A brand sprint for Hark: raw frozen food for dogs.","image":"","keywords":"","schemaMarkup":null},"token":""},"__N_SSG":true}