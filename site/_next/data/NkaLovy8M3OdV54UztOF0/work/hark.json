{"pageProps":{"work":{"_createdAt":"2025-04-28T17:36:11Z","_id":"2e605a85-cdeb-45e7-8f33-ce846797a645","_rev":"h53se4Pc2uw77GU24lWtL2","_system":{"base":{"id":"2e605a85-cdeb-45e7-8f33-ce846797a645","rev":"0kZPXms1Imn9mJJJfpOCoE"}},"_type":"work","_updatedAt":"2026-07-06T18:53:19Z","metaDescription":"A brand sprint for Hark: raw frozen food for dogs.","nextProject":{"_createdAt":"2025-02-14T23:52:18Z","_id":"c4c74034-6473-4742-8d16-597b62603a20","_rev":"RT1ayPv3t1OpoFCZh5mUNf","_system":{"base":{"id":"c4c74034-6473-4742-8d16-597b62603a20","rev":"h53se4Pc2uw77GU24llycc"}},"_type":"work","_updatedAt":"2026-07-06T20:56:02Z","metaDescription":"Montfort Capital — private credit financial branding and website design by Gimetry Studio","nextProject":{"_ref":"8064c316-b8ab-4f11-95a6-0bfb03866579","_type":"reference"},"orderRank":"0|100012:","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"monfort-capital"},"thumbnailContent":{"_type":"media","mediaType":"video","video":"/ext/video/1083700295-720p.mp4","videoAdaptive":null,"vimeoId":"1083700295"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-13dbf788147da0c02c46a9910bb3fde8b2c51547-1320x880-jpg","_type":"reference"}},"mediaType":"video","video":"/ext/video/788088899-1080p.mp4","videoAdaptive":null,"vimeoId":"788088899"},"thumbnailExcerpt":"Designing a financial disruptor.","title":"Montfort Capital","workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ebeae9"},"heroMedia":{"_type":"media","mediaType":"video","video":"/ext/video/788450671-1080p.mp4","videoAdaptive":null,"vimeoId":"788450671"},"sectionContent":[{"_key":"3d0c8ec6b27b","_type":"block","children":[{"_key":"809a8ce17a140","_type":"span","marks":[],"text":"Montfort Capital is building a future where private credit is accessible to everyone. They needed a bold identity to match their bold vision."}],"markDefs":[],"style":"normal"}],"servicesList":["Naming","Brand Identity","Web Design","Print"],"websiteURL":"https://montfortcapital.com/"},"workModules":[{"_key":"dd3935e5dc25","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-0148660339a16cf40d3b3ef4607f04d84a1bb63e-3200x2000-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"63ee2bb7ebb2","_type":"workTextBlock","content":[{"_key":"7f82cf7c6fd3","_type":"block","children":[{"_key":"9a634888fab10","_type":"span","marks":[],"text":"Montfort came to us with a blank slate: A nameless portfolio of companies making private credit accessible to investors."}],"markDefs":[],"style":"normal"},{"_key":"ee33b6391dd9","_type":"block","children":[{"_key":"8e99f1673ab60","_type":"span","marks":[],"text":"Our challenge was to create a unifying brand that felt trusted, timeless, and familiar, while establishing itself as a modern disrupter to an archaic industry."}],"markDefs":[],"style":"normal"}],"title":"What's in a name?"},{"_key":"037a7bb5e556","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-7d5d3d1e793b6cdf2f9d97ab2ddca0970f849723-3200x1801-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"f5639b1f5e47","_type":"workTextBlock","content":[{"_key":"7fa201da2505","_type":"block","children":[{"_key":"ec1c49dc33220","_type":"span","marks":[],"text":"It was clear from the start that bringing together these disparate pieces required more than just a name and a logo."}],"markDefs":[],"style":"normal"},{"_key":"198cd39fe5f7","_type":"block","children":[{"_key":"907adc2b000f0","_type":"span","marks":[],"text":"So we began to imagine Montfort not as a brand, but a destination. A world of aspirational spaces, powered by smart investing decisions, that invite you to step inside and create your own stories."}],"markDefs":[],"style":"normal"},{"_key":"e505aeb690c9","_type":"block","children":[{"_key":"ea61bd8d1459","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"title":"Building the Montfort story"},{"_key":"6eb7187a9a7c","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-a94b1813e73f96db31025e05a3e3b081b57f8bb4-1600x1600-jpg","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/788088941-1080p.mp4","videoAdaptive":null}},{"_key":"727ae1e8a639","_type":"workTextBlock","content":[{"_key":"6458126fcad8","_type":"block","children":[{"_key":"2a23b3c6eb710","_type":"span","marks":[],"text":"Inspired by broadsheets, ledgers, and printed reports, digital touchpoints nod to physical counterparts, creating a cohesive brand experience whether you’re on a boat or in the boardroom."}],"markDefs":[],"style":"normal"},{"_key":"c048557829ce","_type":"block","children":[{"_key":"9a95f0737f6d","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"title":"Putting stock in the brand"},{"_key":"ed74635e2cd4","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-1d24ed98215fd78b482c3ef735345d805a1fba7e-3200x2061-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"083a957f9232","_type":"workDoubleImage","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/788088951-1080p.mp4","videoAdaptive":null},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-bc62584d034058cee015e48e822ef16b2bdf25af-1600x1600-jpg","_type":"reference"}},"mediaType":"image"}}]},"orderRank":"0|10000x:d","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"hark"},"thumbnailContent":{"_type":"media","mediaType":"video","video":"/ext/video/1083700247-720p.mp4","videoAdaptive":null,"vimeoId":"1083700247"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-531cae6d4c912f73697b162c28b5234ddccfd70a-3408x2272-webp","_type":"reference"}},"mediaType":"image"},"thumbnailExcerpt":"Design sprint for the most complete raw frozen dog food.","title":"Hark","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ffd3e5"},"buttonColor":"black","heroMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-531cae6d4c912f73697b162c28b5234ddccfd70a-3408x2272-webp","_type":"reference"}},"mediaType":"image"},"sectionContent":[{"_key":"537be6639ff0","_type":"block","children":[{"_key":"45cb1ea5b4ba0","_type":"span","marks":[],"text":"Hark is putting wags into bags, with the only human-grade raw food that's also made with heart-healthy grains and whole ingredients."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand Identity","Website Design"],"textColor":"darkGray"},"workModules":[{"_key":"95a61e1409ee","_type":"workTextBlock","content":[{"_key":"8c3596bb770f","_type":"block","children":[{"_key":"8cbd6d32a802","_type":"span","marks":[],"text":"Hark engaged Gimetry Studio looking for a brand sprint. We try to only do a few of these a year, and only for brands that we think will make them count. In this instance the founding team had clear messaging and a robust internal positioning document, and just needed a quick-to-market identity that would help them establish an initial brand playbook for fundraising. Plus, dogs. Done deal."}],"markDefs":[],"style":"normal"}],"title":"Who's a good brand?"},{"_key":"16a1987b74be632b5a477c3001f20820","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-65c6cba394df84340d98706ad204eb9e7e15db9d-1680x2100-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-cd607650fbb4260e9c4938e665e98a4021631f2a-840x1050-gif","_type":"reference"}},"mediaType":"gif"}},{"_key":"d928fb3ec0b7","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/1079583364-2160p.mp4","videoAdaptive":null,"vimeoId":"1079583364"}},{"_key":"1cc2972247c9","_type":"workTextBlock","content":[{"_key":"2b3b209e1d08","_type":"block","children":[{"_key":"ee2506e01848","_type":"span","marks":[],"text":"As out-and-out dog lovers, the team leapt at the opportunity to unleash on this one. Inspired by the telltale \"clink\" sound of frozen food hitting a dog bowl, we quickly fell in love with the idea of an onomatopoeic brand — one that let us use dynamic typography to emulate happy pups of all types.\n\nIn just under two weeks we had a complete brand toolbox handed over, all within Figma for complete flexibility. The sprint included logos, packaging, photography styles, launch graphics and a one page website homepage."}],"markDefs":[],"style":"normal"}],"title":"A design you can hear"},{"_key":"621e83325fdc","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/1079863100-1440p.mp4","videoAdaptive":null}},{"_key":"e62771345d0a","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-2bbe87b7f637df81f3fe682c0695c4c39a1c253e-1680x2100-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-181bf72daa29a2b46df9fd2cc2aff58f9a2ef842-1680x2100-webp","_type":"reference"}},"mediaType":"image"}}]},"params":{"slug":"hark"},"globalSettings":{"_createdAt":"2024-10-22T20:44:16Z","_id":"globalSettings","_rev":"6p8vZffvPAFD6E6aSNtKo2","_type":"globalSettings","_updatedAt":"2025-04-24T03:14:08Z","footer":{"email":"yuxuen1993@gmail.com","infoPages":[{"_key":"841d1d64f5ea","_type":"pageLink","path":"/careers","title":"Collaborate"},{"_key":"3ffc11fd5737","_type":"pageLink","path":"/contact","title":"Contact Us"}],"phoneNumber":"+60 11-6368 3842","socials":[]}},"draftMode":false,"seo":{"title":"Hark — Gimetry Studio","description":"A brand sprint for Hark: raw frozen food for dogs.","image":"","keywords":"","schemaMarkup":null},"token":""},"__N_SSG":true}