"url":"/ext/vimeo-img/1982775590-cbc6362d673b2ed8215c4a81edb425c0609c9d6def5c86788feea0554b94956e-d.jpg"},"video":"/ext/video/1056931311-720p.mp4","videoAdaptive":null,"vimeoId":"1056931311"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-9f1ecc195e49e49ed13614209f63e9024c707b58-1920x1080-png","_type":"reference"}},"mediaType":"image","video":"https://player.vimeo.com/progressive_redirect/playback/1056895104/rendition/1080p/file.mp4?loc=external&log_user=0&signature=02f39b2250376c2fffe482974b6984c89c7f64526e3724dc8bbcfbfb1813cefa&user_id=107715540","vimeoId":"1056895104"},"thumbnailExcerpt":"A smashing brand for Johor Bahru's premier tennis school.","title":"Summer Smash Tennis","workHeroSection":{"backgroundColor":{"label":"Custom","value":"#80c1e8"},"heroMedia":{"_type":"media","mediaType":"video","video":"/ext/video/950864633-1080p.mp4","videoAdaptive":null,"vimeoId":"950864633"},"sectionContent":[{"_key":"4efa2f2f54d6","_type":"block","children":[{"_key":"a22ea88bc3370","_type":"span","marks":[],"text":"Summer Smash Tennis is Johor Bahru’s premier tennis academy. We served up a new brand and website to help them ace the space."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand identity","Art direction","Web design","Development"],"websiteURL":"https://summersmashtennis.ca/"},"workModules":[{"_key":"33be2ec5556a","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 950864633","url":"/ext/vimeo-img/1859679745-5faf021d4a272f1fcce6063d6fe93af91338bd0ec4437bc4d6e6bdabe92b9da0-d.jpg"},"video":"/ext/video/950843298-2160p.mp4","videoAdaptive":null,"vimeoId":"950843298"}},{"_key":"9febe415f59d","_type":"workDoubleImage","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/950841405-720p.mp4","videoAdaptive":null},"rightMedia":{"_type":"media","image":{"_type":"image","alt":"Bag","asset":{"_ref":"image-40413f2265f339553f5137dacd084562177221e4-1600x1600-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"0088a9b94649","_type":"workTextBlock","content":[{"_key":"6f7e92419153","_type":"block","children":[{"_key":"d5e8cd7d368c0","_type":"span","marks":[],"text":"The coaches at Summer Smash Tennis are dedicated to helping people Play Beautifully."}],"markDefs":[],"style":"normal"},{"_key":"2d15f3a57c0e","_type":"block","children":[{"_key":"9c4e4dfef852","_type":"span","marks":[],"text":"For them, tennis is more than a sport. It’s an opportunity for players to be part of a community, grow as individuals, and—most of all—have some fun.\n\nIn reimagining the brand, we knew we wanted to capture that same welcoming, uplifting spirit."}],"markDefs":[],"style":"normal"}],"title":"Love All"},{"_key":"c53aedac0fd2","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","alt":"Summer Smash Tennis Posters","asset":{"_ref":"image-39d2f21d1eebf2a727ac48ca9ffb4d25874303ed-3200x1800-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"f43c8f18e318","_type":"workTextBlock","content":[{"_key":"4f0c9665d884","_type":"block","children":[{"_key":"1494bcaf2cb80","_type":"span","marks":[],"text":"The brandmark and colour palette is inspired by retro summer camps and sunny Johor Bahru afternoons. Stickers and mixed media graphics transform photos into heightened moments of playfulness, serving as a reminder to see the joy in every swing."}],"markDefs":[],"style":"normal"}],"title":"Designed to delight"},{"_key":"15d470ba6327","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","alt":"SST Mobile","asset":{"_ref":"image-c2037f470c4a6baa42197df1cced3059b21f279e-1600x1600-jpg","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/950843484-2160p.mp4","videoAdaptive":null,"vimeoId":"950843484"}},{"_key":"f72a0a5db2fd","_type":"workTextBlock","content":[{"_key":"437742d799df","_type":"block","children":[{"_key":"e3657876a24d0","_type":"span","marks":[],"text":"In addition to the brand, we also rebuilt the Summer Smash website from the ground up.\n\nA refreshed information architecture ensures class information is readily accessible, and custom CMS plugins make updates more manageable for the admin team. Moments of joy are interspersed throughout the site to elevate the user experience and better reflect the level of quality on offer.\n\nSince launch, Summer Smash Tennis has seen more than a 50% increase in class registrations."}],"markDefs":[],"style":"normal"}],"title":"A website that wins"},{"_key":"63f2e9524148","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/950856095-2160p.mp4","videoAdaptive":null}}]},"params":{"slug":"summer-smash-tennis"},"globalSettings":{"_createdAt":"2024-10-22T20:44:16Z","_id":"globalSettings","_rev":"6p8vZffvPAFD6E6aSNtKo2","_type":"globalSettings","_updatedAt":"2025-04-24T03:14:08Z","footer":{"email":"yuxuen1993@gmail.com","infoPages":[{"_key":"841d1d64f5ea","_type":"pageLink","path":"/careers","title":"Collaborate"},{"_key":"3ffc11fd5737","_type":"pageLink","path":"/contact","title":"Contact Us"}],"phoneNumber":"+60 11-6368 3842","socials":[]}},"draftMode":false,"seo":{"title":"Summer Smash Tennis — Gimetry Studio","description":"Designing and website design project for Johor Bahru's premier tennis academy.","image":"","keywords":"","schemaMarkup":null},"token":""},"__N_SSG":true}