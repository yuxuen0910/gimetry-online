{"pageProps":{"work":{"_createdAt":"2026-04-13T21:10:32Z","_id":"a165056d-2b7d-4194-ba89-2789921af98b","_rev":"RT1ayPv3t1OpoFCZh56crJ","_system":{"base":{"id":"a165056d-2b7d-4194-ba89-2789921af98b","rev":"lLnYSc1fIgTDwn2MWSWHSS"}},"_type":"work","_updatedAt":"2026-07-06T17:55:40Z","nextProject":{"_createdAt":"2026-02-23T19:33:33Z","_id":"7f0725d0-d503-4d16-bf3e-f6e5385c89d6","_rev":"RT1ayPv3t1OpoFCZh5OHXs","_system":{"base":{"id":"7f0725d0-d503-4d16-bf3e-f6e5385c89d6","rev":"5rEo4eho0WPFec3f7amo86"}},"_type":"work","_updatedAt":"2026-07-06T18:17:02Z","metaDescription":"Lumina Fintech is an AI loan platform in Malaysia offering smart loan matching, AI credit assessment, and loan eligibility checks for personal and SME borrowers. Website and product experience designed and built by Gimetry Studio.","metaTitle":"Lumina Fintech","nextProject":{"_ref":"836caedf-c8f1-4283-a490-188eba4468d0","_type":"reference"},"ogImage":{"_type":"image","asset":{"_ref":"image-3df7626eee0f97d87a5cfd2885efb99a6b00eb67-2400x1260-jpg","_type":"reference"}},"orderRank":"0|052903:","ourProcess":{"content":[{"_key":"8cf880859319","_type":"block","children":[{"_key":"6e780e9406d4","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"2451d8799682","_type":"block","children":[{"_key":"8419f5415d56","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"hideProcessButton":true},"slug":{"_type":"slug","current":"hamilton"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1195724705","url":"/ext/vimeo-img/2161656966-a3a03e7217f877b7c48c5d2ed6959162dc7ee029fe0d36f51f6c1324f6cbc48d-d.jpg"},"video":"/ext/video/1195724705-720p.mp4","videoAdaptive":null,"vimeoId":"1195724705"},"thumbnailCover":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1172349764","url":"/ext/vimeo-img/2132157640-668c592a2c65e60b1e32f677454b8a881d84fba24cde654a2e4786cdff088a4a-d.jpg"},"video":"/ext/video/1172349764-2160p.mp4","videoAdaptive":null,"vimeoId":"1172349764"},"thumbnailExcerpt":"An AI loan platform that explains every recommendation.","title":"Lumina Fintech","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#c9c9c9"},"buttonColor":"black","heroMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1172349764","url":"/ext/vimeo-img/2132157640-668c592a2c65e60b1e32f677454b8a881d84fba24cde654a2e4786cdff088a4a-d.jpg"},"video":"/ext/video/1172349764-2160p.mp4","videoAdaptive":null,"vimeoId":"1172349764"},"sectionContent":[{"_key":"47de3f5d3442","_type":"block","children":[{"_key":"764326b922c50","_type":"span","marks":[],"text":"Lumina Fintech is an AI loan platform in Malaysia that pairs smart loan matching with fair, explainable AI credit assessment for personal and SME borrowers. From strategy to launch, we designed and built a digital product experience that makes complex lending decisions feel clear, trustworthy, and effortless."}],"markDefs":[],"style":"normal"}],"servicesList":["Web Design","Product Experience","Development"],"textColor":"darkGray","websiteURL":"https://luminafintech.com/"},"workModules":[{"_key":"256bc3cc4d4e","_type":"workTextBlock","content":[{"_key":"240c818d82ae","_type":"block","children":[{"_key":"6df3e8f2fbb60","_type":"span","marks":[],"text":"In an industry crowded with fine print and opaque approvals, Lumina set out to stand apart. The challenge was to translate a serious financial product into a visual language that felt trustworthy for everyday borrowers while still expressing a modern, innovation-led brand tone."}],"markDefs":[],"style":"normal"},{"_key":"36e02912d4be","_type":"block","children":[{"_key":"f417cde77451","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d7c68eab2d7f","_type":"block","children":[{"_key":"359c6741e0d80","_type":"span","marks":[],"text":"Lending traditionally hides behind jargon and asks for trust up front. Lumina takes the opposite view: borrowers deserve to understand every recommendation before they commit. From AI credit assessment to loan eligibility checks, the product explains itself in plain language at every step. That conviction became the foundation of the entire experience: clarity first."}],"markDefs":[],"style":"normal"}],"title":"Clarity First."},{"_key":"60cc46acb0fc","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1172350814","url":"/ext/vimeo-img/2132162057-1c25dcb110ce47ea57a70579388c1ec442715c9c79a47f56b080e2d9e11368fd-d.jpg"},"video":"/ext/video/1172350814-2160p.mp4","videoAdaptive":null,"vimeoId":"1172350814"}},{"_key":"b5c2bf7274d0","_type":"workTextBlock","content":[{"_key":"d54b8bcfea2c","_type":"block","children":[{"_key":"dac1c02448a90","_type":"span","marks":[],"text":"A scalable framework of reusable sections anchors the experience, giving every feature page a consistent rhythm. Clear CTA hierarchy guides borrowers toward eligibility checks, while restrained motion accents add energy without undermining trust. The interface itself is clean, balanced, and dependable."}],"markDefs":[],"style":"normal"}],"title":"AI Automation"},{"_key":"6f6b6ac53d7f","_type":"workDouble45","leftMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1172349989","url":"/ext/vimeo-img/2132157929-bdc16e8da06b96235534154ae8a50f75ea67a088e4038a735790a3202b8d2be0-d.jpg"},"video":"/ext/video/1172349989-2160p.mp4","videoAdaptive":null,"vimeoId":"1172349989"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-812004c1601489d74e390069658cacc722dcdac6-2880x3840-png","_type":"reference"}},"mediaType":"image"}},{"_key":"606c96438de3","_type":"workTextBlock","content":[{"_key":"701fec56a414","_type":"block","children":[{"_key":"978f8280936d0","_type":"span","marks":[],"text":"The website goes beyond marketing pages and behaves like a working product. Live match scores, a loan comparison dashboard, and a suite of six financial calculators — from affordability to stamp duty — give borrowers real answers before they ever apply."}],"markDefs":[],"style":"normal"},{"_key":"2ac711efc83d","_type":"block","children":[{"_key":"4e6b666667df","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"bef87fd29b1f","_type":"block","children":[{"_key":"b473005d8cd6","_type":"span","marks":[],"text":"As users move from eligibility checks to lender comparisons, the mobile-first interface stays consistent throughout, reinforcing Lumina's promise that every recommendation is transparent and reviewable."}],"markDefs":[],"style":"normal"}],"title":"Website"},{"_key":"73a1aa7755fd","_type":"workSingleImage","capWidth":true,"media":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1172350033","url":"/ext/vimeo-img/2132158000-740c1bad9ea337a39c280f353d741238ac760668a619a1c7e1ef7b38c3a6b7d1-d.jpg"},"video":"/ext/video/1172350033-2160p.mp4","videoAdaptive":null,"vimeoId":"1172350033"}},{"_key":"8464d336d607","_type":"workTextBlock","capWidth":false,"content":[{"_key":"d57f59d653d1","_type":"block","children":[{"_key":"14c9106048cb0","_type":"span","marks":[],"text":"Dense feature communication was a core constraint: the system had to support future feature pages without redesigning from scratch. Reusable sections, a disciplined type scale, and consistent component behaviour keep the product UI and campaign visuals in perfect alignment."}],"markDefs":[],"style":"normal"},{"_key":"1c70048d7852","_type":"block","children":[{"_key":"aaa97cacd6b3","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"1487abdb4eeb","_type":"block","children":[{"_key":"54537b583552","_type":"span","marks":[],"text":"The result is a digital presence that grows with the platform — as considered and dependable as the product itself."}],"markDefs":[],"style":"normal"}],"title":"Built to Scale"},{"_key":"7e2778ce5a4c","_type":"workDouble45","capWidth":false,"leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-7976b63a1a3ca1a8ba0e703087a9d7b92c58acf9-2160x2880-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-4f079b28ec3bf12998c3d1f89edc656b2b3c5aa5-2160x2880-webp","_type":"reference"}},"mediaType":"image"}},{"_key":"0858e1f3ad54","_type":"workSingleImage","capWidth":false,"media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-9a1847e09dc353823dfb79aca6320c1a803077e5-3840x2160-webp","_type":"reference"}},"mediaType":"image"}}]},"ogImage":{"_type":"image","asset":{"_ref":"image-b6c42439402af172b9f8789f9d77eeb1c103e7a9-700x525-webp","_type":"reference"}},"orderRank":"0|02j4i1:","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"cipher-digital"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1195700229","url":"/ext/vimeo-img/2161626573-1f0b84d1c215d698078ba99c7ed24c3c7da239ce489a213162ab08041ef060ea-d.jpg"},"video":"/ext/video/1195700229-720p.mp4","videoAdaptive":null,"vimeoId":"1195700229"},"thumbnailCover":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1192020090","url":"/ext/vimeo-img/2157173693-787ba5fbd58ecb65aceedf068e3fd263f8e3a2596f6954b7ec7b484d7555c93c-d.jpg"},"video":"/ext/video/1192020090-2160p.mp4","videoAdaptive":null,"vimeoId":"1192020090"},"thumbnailExcerpt":"Talent, AI, and robotics — a digital home for the smarter workforce.","title":"Nexora","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#e4e9ed"},"buttonColor":"black","heroMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1192020090","url":"/ext/vimeo-img/2157173693-787ba5fbd58ecb65aceedf068e3fd263f8e3a2596f6954b7ec7b484d7555c93c-d.jpg"},"video":"/ext/video/1192020090-2160p.mp4","videoAdaptive":null,"vimeoId":"1192020090"},"sectionContent":[{"_key":"7aefaf8fbd97","_type":"block","children":[{"_key":"d3a8448a13970","_type":"span","marks":[],"text":"Nexora is a smart-workforce company uniting talent, AI, and robotics for enterprises across Southeast Asia and global markets. To match a vision that spans humanoids, delivery robots, and warehouse automation, we designed and built a digital experience that makes the future of work feel like it is already here."}],"markDefs":[],"style":"normal"}],"servicesList":["Web Design","Development","Motion & Interaction"],"textColor":"darkGray","websiteURL":"https://nexoradynamics-web.vercel.app/"},"workModules":[{"_key":"8bc2f9b70317","_type":"workTextBlock","capWidth":false,"content":[{"_key":"6ae8bfd8aa4b","_type":"block","children":[{"_key":"f53f4c218f93","_type":"span","marks":[],"text":"Nexora deploys talent, AI, and robotics across 10 countries on 5 continents — from humanoid deployment and sidewalk delivery to full-scale warehouse automation. Their solutions ship as seamlessly as software: engage once, scale fast."}],"markDefs":[],"style":"normal"},{"_key":"498ccfe4b25b","_type":"block","children":[{"_key":"f53f4c218f93","_type":"span","marks":[],"text":"The brief was clear from day one: not theory, not tomorrow — today. The website had to make an emerging robotics company feel proven, operational, and "},{"_key":"cd6d1b4edab5","_type":"span","marks":["em"],"text":"ready to deploy "},{"_key":"aff4014fe0bb","_type":"span","marks":[],"text":"at enterprise scale."}],"markDefs":[],"style":"normal"}],"title":"Smarter workforce. Stronger future."},{"_key":"b5c407a6b646","_type":"workSingleImage","capWidth":false,"media":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1194538737","url":"/ext/vimeo-img/2160214327-581e92b68847aa89ce791dce5b4c33ebbcf4b2472b949ac44b8c7e83aec87067-d.jpg"},"video":"/ext/video/1194538737-2160p.mp4","videoAdaptive":null,"vimeoId":"1194538737"}},{"_key":"c7be9330f404","_type":"workPortableText","alignment":"left","content":[{"_key":"a71e700b66cb","_type":"block","children":[{"_key":"8c58090bc7d9","_type":"span","marks":[],"text":"Not theory. Not tomorrow. Today."}],"markDefs":[],"style":"h3"},{"_key":"4cef8794f165","_type":"block","children":[{"_key":"4554d4c8b58c","_type":"span","marks":[],"text":"The site leads with outcomes instead of promises. Live stats, real deployments, and partners like Sodexo, Grubhub, GXO, and AWS anchor every claim in evidence."}],"markDefs":[],"style":"normal"},{"_key":"fbc40a524e14","_type":"block","children":[{"_key":"4554d4c8b58c","_type":"span","marks":[],"text":"Full-bleed video, kinetic type reveals, and glitch-inflected details give the brand its voice — confident, precise, and unmistakably in motion."}],"markDefs":[],"style":"normal"}]},{"_key":"fc5ce3b85c98","_type":"workSingleImage","capWidth":true,"media":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1192087101","url":"/ext/vimeo-img/2157257415-44e4b761e57fb536f8c2df35483c7e4cc52efdf594e880630dc160dcb2b92e00-d.jpg"},"video":"/ext/video/1192087101-1080p.mp4","videoAdaptive":null,"vimeoId":"1192087101"}},{"_key":"2d51e41ea11d","_type":"workDouble34","capWidth":true,"leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-3f5700fb58b7ea5be24a7e6b6a30265ab491df1d-660x880-png","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-46778dd0de97b79972f8456b289643eabf236164-1884x2512-webp","_type":"reference"}},"mediaType":"image"}},{"_key":"a1c752137cff","_type":"workTextBlock","capWidth":true,"content":[{"_key":"18c5a823e589","_type":"block","children":[{"_key":"459fd0012d34","_type":"span","marks":[],"text":"Four product lines — Humanoid, Robotics, Delivery, and Warehouses — each receive a dedicated showcase built around large-scale imagery, product renders, and scroll-driven motion."}],"markDefs":[],"style":"normal"},{"_key":"32beaa999463","_type":"block","children":[{"_key":"178e080e4dfa","_type":"span","marks":[],"text":"Interactive modules like the unfolding solutions accordion, dynamic stat counters, and pixel-card hovers keep the experience tactile, while the underlying system stays clean, fast, and functional."}],"markDefs":[],"style":"normal"}],"title":"Workforce for the real world."},{"_key":"30c8b0bc2dc9","_type":"workPortableText","alignment":"center","content":[{"_key":"36b435fe1b4c","_type":"block","children":[{"_key":"459fd0012d34","_type":"span","marks":[],"text":"Designed and built end to end — explore the live experience at "},{"_key":"15cf33f1833c","_type":"span","marks":["4e248c99b15b","underline"],"text":"nexoradynamics-web.vercel.app"},{"_key":"2431c030fd5d","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"4e248c99b15b","_type":"link","href":"https://nexoradynamics-web.vercel.app/"}],"style":"normal"}]},{"_key":"415f99254938","_type":"workSingleImage","capWidth":false,"media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-812c74a2b48c9a207ce4d0f104e2ef80cededc7a-3840x2160-webp","_type":"reference"}},"mediaType":"image"}},{"_key":"9604f00e37db","_type":"workSingleImage","capWidth":false,"media":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1194499509","url":"/ext/vimeo-img/2160166023-4aee34cd73b2c96f1bcf876ba404cebfd54a5417a41839b865a4339dfe6606a0-d.jpg"},"video":"/ext/video/1194499509-2160p.mp4","videoAdaptive":null,"vimeoId":"1194499509"}}]},"params":{"slug":"cipher-digital"},"globalSettings":{"_createdAt":"2024-10-22T20:44:16Z","_id":"globalSettings","_rev":"6p8vZffvPAFD6E6aSNtKo2","_type":"globalSettings","_updatedAt":"2025-04-24T03:14:08Z","footer":{"email":"yuxuen1993@gmail.com","infoPages":[{"_key":"841d1d64f5ea","_type":"pageLink","path":"/careers","title":"Collaborate"},{"_key":"3ffc11fd5737","_type":"pageLink","path":"/contact","title":"Contact Us"}],"phone