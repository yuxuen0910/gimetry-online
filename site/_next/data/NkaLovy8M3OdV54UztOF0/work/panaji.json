{"pageProps":{"work":{"_createdAt":"2025-06-24T17:42:10Z","_id":"c959281f-a110-4018-8540-12fdc2306514","_rev":"tTlXFWaLzsE9XjbfIDaE3S","_system":{"base":{"id":"c959281f-a110-4018-8540-12fdc2306514","rev":"4F981eRZDoiTcd4BI2b9VF"}},"_type":"work","_updatedAt":"2026-07-06T18:47:53Z","nextProject":{"_createdAt":"2025-05-21T16:38:23Z","_id":"9c025ab6-75c5-4fc3-abfa-91fb648a6944","_rev":"h53se4Pc2uw77GU24lWUqA","_system":{"base":{"id":"9c025ab6-75c5-4fc3-abfa-91fb648a6944","rev":"k6OVubA1w6FSpjUryCKfjh"}},"_type":"work","_updatedAt":"2026-07-06T18:51:25Z","metaDescription":"Gimetry Studio crafted an sleek and intentional website design for Pen Name Consulting that matches the caliber of their work and clients.","metaTitle":"Gimetry Studio | Web Design & Development for Pen Name","nextProject":{"_ref":"2e605a85-cdeb-45e7-8f33-ce846797a645","_type":"reference"},"ogImage":{"_type":"image","asset":{"_ref":"image-53cc47641f767c4b3eaf084d104b81b230b8e7ba-1200x600-jpg","_type":"reference"}},"orderRank":"0|10000x:9","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"pen-name"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1089177352","url":"/ext/vimeo-img/2021557108-831aebfbc15d6acb386dbf23228d2a2e8c56e7fe1a0429c1f635c534b8bb4e86-d.jpg"},"video":"/ext/video/1089177352-720p.mp4","videoAdaptive":null,"vimeoId":"1089177352"},"thumbnailCover":{"_type":"media","mediaType":"video","video":"/ext/video/1086473300-1080p.mp4","videoAdaptive":null,"vimeoId":"1086473300"},"thumbnailExcerpt":"Bringing a secretive full-service agency to life.","title":"Pen Name","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#f03a2f"},"buttonColor":"black","heroMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1086473300-1080p.mp4","videoAdaptive":null,"vimeoId":"1086473300"},"sectionContent":[{"_key":"0d6c69db4948","_type":"block","children":[{"_key":"24246005ec230","_type":"span","marks":[],"text":"Pen Name sets the standard for high-impact creative — trusted by names like Tim Ferriss, LeBron James, Arnold Schwarzenegger, and Reid Hoffman. From top-ranked podcasts to iconic brand launches, their work shapes culture at the highest level."}],"markDefs":[],"style":"normal"}],"servicesList":["Web Design","Web Development","Art Direction"],"textColor":"white","websiteURL":"https://penname.co/"},"workModules":[{"_key":"159368e0af35","_type":"workDouble45","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1087848643-1440p.mp4","vimeoId":"1087848643"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1087848650-1440p.mp4","vimeoId":"1087848650"}},{"_key":"0ede5cca57ae","_type":"workTextBlock","content":[{"_key":"c80231279fa4","_type":"block","children":[{"_key":"425df377f3890","_type":"span","marks":[],"text":"While Pen Name’s work stands out, their website was dated, static, and understated to a fault, a stark contrast to the impact they’re known for. We partnered with Pen Name to create a digital presence that matches the caliber of their output. The goal: build a site as confident and intentional as the work it showcases."}],"markDefs":[],"style":"normal"}],"title":"The Project"},{"_key":"1beea1f92537","_type":"workDouble45","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1087848657-1440p.mp4","vimeoId":"1087848657"},"rightMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1088830827","url":"/ext/vimeo-img/2021138529-ab1a2e04e94192d2fe4f4dcaadbaae00da3b2a418ad1d945b558ec2577ed6e63-d.jpg"},"video":"/ext/video/1088830827-1440p.mp4","vimeoId":"1088830827"}},{"_key":"313f9deced29","_type":"workTextBlock","content":[{"_key":"37855c1c342f","_type":"block","children":[{"_key":"ce52184e326a0","_type":"span","marks":[],"text":"Our job wasn’t to make them louder. It was to make them undeniable. We built a site that mirrors the way they operate: sharp, fast, and deeply intentional. Every interaction is considered. Every detail earns its place. From the navigation to the motion to the typography, nothing is added without purpose. The site doesn’t try to impress, it simply reflects the confidence of a team that knows exactly what they’re doing. It’s a platform that speaks clearly, works seamlessly, and holds up to the level of names that trust Pen Name with their reputation."}],"markDefs":[],"style":"normal"}],"title":"A Crafted Experience"},{"_key":"46eb4bdbb634","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/1087848671-2160p.mp4","videoAdaptive":null,"vimeoId":"1087848671"}},{"_key":"6122c91aeb1d","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-f786728db923f1f71a1e720a48e5aca57a4988a7-2532x3165-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-50a8c4196841b159076749f74e279d198c8cf34c-1680x2100-webp","_type":"reference"}},"mediaType":"image"}}]},"orderRank":"0|10000w:i","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"panaji"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1099738598","url":"/ext/vimeo-img/2034767082-a1528c35d796baf0e44f00608f66f9ec500d38a09bf8aa293fc27c03b9be4046-d.jpg"},"video":"/ext/video/1099738598-720p.mp4","videoAdaptive":null,"vimeoId":"1099738598"},"thumbnailCover":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1100744413","url":"/ext/vimeo-img/2036031637-7e1d8a9df90b7264ee56c8582bdc67a8354dd7b51514461d3bccfa52f584bab1-d.jpg"},"video":"/ext/video/1100744413-720p.mp4","videoAdaptive":null,"vimeoId":"1100744413"},"thumbnailExcerpt":"Crafting a tasty new website for Panaji Naan.","title":"Panaji","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#f7c300"},"buttonColor":"black","heroMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1100744413","url":"/ext/vimeo-img/2036031637-7e1d8a9df90b7264ee56c8582bdc67a8354dd7b51514461d3bccfa52f584bab1-d.jpg"},"video":"/ext/video/1100744413-1080p.mp4","videoAdaptive":null,"vimeoId":"1100744413"},"sectionContent":[{"_key":"379f8593da70","_type":"block","children":[{"_key":"1aa8ed59aa230","_type":"span","marks":[],"text":"Panaji bakes the world's fluffiest flatbreads. With a strong retail presence and plans to scale, they had an appetite for a new website that would set the table for future growth."}],"markDefs":[],"style":"normal"}],"servicesList":["Web Design","Art Direction","Copywriting","Video Production"],"textColor":"darkGray","websiteURL":"https://panajinaan.com/"},"workModules":[{"_key":"76a567284673","_type":"workTextBlock","content":[{"_key":"a24d164b11b9","_type":"block","children":[{"_key":"a0a63610a8060","_type":"span","marks":[],"text":"Panaji makes famously fluffy, deliciously buttery naan flatbreads for every meal and moment. The brand already had standout packaging, a vibrant visual foundation, and a product that people genuinely loved. The only thing missing was an impactful website to match."}],"markDefs":[],"style":"normal"},{"_key":"c371e631f82c","_type":"block","children":[{"_key":"01211b7ff617","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"f6e0d0400773","_type":"block","children":[{"_key":"43dfd34e9475","_type":"span","marks":[],"text":"Inspired by the colourful product packaging—and the joy of great food shared with friends—our visual approach captures vibrant, expressive, and authentic moments spent around the table."}],"markDefs":[],"style":"normal"}],"title":"Not your average naan"},{"_key":"cf76d80d767e","_type":"workDouble45","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1099737648-1080p.mp4","videoAdaptive":null,"vimeoId":"1099737648"},"rightMedia":{"_type":"media","mediaType":"video","vi