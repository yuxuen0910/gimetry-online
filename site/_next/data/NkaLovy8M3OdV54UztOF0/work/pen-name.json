{"pageProps":{"work":{"_createdAt":"2025-05-21T16:38:23Z","_id":"9c025ab6-75c5-4fc3-abfa-91fb648a6944","_rev":"h53se4Pc2uw77GU24lWUqA","_system":{"base":{"id":"9c025ab6-75c5-4fc3-abfa-91fb648a6944","rev":"k6OVubA1w6FSpjUryCKfjh"}},"_type":"work","_updatedAt":"2026-07-06T18:51:25Z","metaDescription":"Gimetry Studio crafted an sleek and intentional website design for Pen Name Consulting that matches the caliber of their work and clients.","metaTitle":"Gimetry Studio | Web Design & Development for Pen Name","nextProject":{"_createdAt":"2025-04-28T17:36:11Z","_id":"2e605a85-cdeb-45e7-8f33-ce846797a645","_rev":"h53se4Pc2uw77GU24lWtL2","_system":{"base":{"id":"2e605a85-cdeb-45e7-8f33-ce846797a645","rev":"0kZPXms1Imn9mJJJfpOCoE"}},"_type":"work","_updatedAt":"2026-07-06T18:53:19Z","metaDescription":"A brand sprint for Hark: raw frozen food for dogs.","nextProject":{"_ref":"c4c74034-6473-4742-8d16-597b62603a20","_type":"reference"},"orderRank":"0|10000x:d","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"hark"},"thumbnailContent":{"_type":"media","mediaType":"video","video":"/ext/video/1083700247-720p.mp4","videoAdaptive":null,"vimeoId":"1083700247"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-531cae6d4c912f73697b162c28b5234ddccfd70a-3408x2272-webp","_type":"reference"}},"mediaType":"image"},"thumbnailExcerpt":"Design sprint for the most complete raw frozen dog food.","title":"Hark","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ffd3e5"},"buttonColor":"black","heroMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-531cae6d4c912f73697b162c28b5234ddccfd70a-3408x2272-webp","_type":"reference"}},"mediaType":"image"},"sectionContent":[{"_key":"537be6639ff0","_type":"block","children":[{"_key":"45cb1ea5b4ba0","_type":"span","marks":[],"text":"Hark is putting wags into bags, with the only human-grade raw food that's also made with heart-healthy grains and whole ingredients."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand Identity","Website Design"],"textColor":"darkGray"},"workModules":[{"_key":"95a61e1409ee","_type":"workTextBlock","content":[{"_key":"8c3596bb770f","_type":"block","children":[{"_key":"8cbd6d32a802","_type":"span","marks":[],"text":"Hark engaged Gimetry Studio looking for a brand sprint. We try to only do a few of these a year, and only for brands that we think will make them count. In this instance the founding team had clear messaging and a robust internal positioning document, and just needed a quick-to-market identity that would help them establish an initial brand playbook for fundraising. Plus, dogs. Done deal."}],"markDefs":[],"style":"normal"}],"title":"Who's a good brand?"},{"_key":"16a1987b74be632b5a477c3001f20820","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-65c6cba394df84340d98706ad204eb9e7e15db9d-1680x2100-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-cd607650fbb4260e9c4938e665e98a4021631f2a-840x1050-gif","_type":"reference"}},"mediaType":"gif"}},{"_key":"d928fb3ec0b7","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/1079583364-2160p.mp4","videoAdaptive":null,"vimeoId":"1079583364"}},{"_key":"1cc2972247c9","_type":"workTextBlock","content":[{"_key":"2b3b209e1d08","_type":"block","children":[{"_key":"ee2506e01848","_type":"span","marks":[],"text":"As out-and-out dog lovers, the team leapt at the opportunity to unleash on this one. Inspired by the telltale \"clink\" sound of frozen food hitting a dog bowl, we quickly fell in love with the idea of an onomatopoeic brand — one that let us use dynamic typography to emulate happy pups of all types.\n\nIn just under two weeks we had a complete brand toolbox handed over, all within Figma for complete flexibility. The sprint included logos, packaging, photography styles, launch graphics and a one page website homepage."}],"markDefs":[],"style":"normal"}],"title":"A design you can hear"},{"_key":"621e83325fdc","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/1079863100-1440p.mp4","videoAdaptive":null}},{"_key":"e62771345d0a","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-2bbe87b7f637df81f3fe682c0695c4c39a1c253e-1680x2100-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-181bf72daa29a2b46df9fd2cc2aff58f9a2ef842-1680x2100-webp","_type":"reference"}},"mediaType":"image"}}]},"ogImage":{"_type":"image","asset":{"_ref":"image-53cc47641f767c4b3eaf084d104b81b230b8e7ba-1200x600-jpg","_type":"reference"}},"orderRank":"0|10000x:9","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"pen-name"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1089177352","url":"/ext/vimeo-img/2021557108-831aebfbc15d6acb386dbf23228d2a2e8c56e7fe1a0429c1f635c534b8bb4e86-d.jpg"},"video":"/ext/video/1089177352-720p.mp4","videoAdaptive":null,"vimeoId":"1089177352"},"thumbnailCover":{"_type":"media","mediaType":"video","video":"/ext/video/1086473300-1080p.mp4","videoAdaptive":null,"vimeoId":"1086473300"},"thumbnailExcerpt":"Bringing a secretive full-service agency to life.","title":"Pen Name","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#f03a2f"},"buttonColor":"black","heroMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1086473300-1080p.mp4","videoAdaptive":null,"vimeoId":"1086473300"},"sectionContent":[{"_key":"0d6c69db4948","_type":"block","children":[{"_key":"24246005ec230","_type":"span","marks":[],"text":"Pen Name sets the standard for high-impact creative — trusted by names like Tim Ferriss, LeBron James, Arnold Schwarzenegger, and Reid Hoffman. From top-ranked podcasts to iconic brand launches, their work shapes culture at the highest level."}],"markDefs":[],"style":"normal"}],"servicesList":["Web Design","Web Development","Art Direction"],"textColor":"white","websiteURL":"https://penname.co/"},"workModules":[{"_key":"159368e0af35","_type":"workDouble45","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1087848643-1440p.mp4","vimeoId":"1087848643"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1087848650-1440p.mp4","vimeoId":"1087848650"}},{"_key":"0ede5cca57ae","_type":"workTextBlock","content":[{"_key":"c80231279fa4","_type":"block","children":[{"_key":"425df377f3890","_type":"span","marks":[],"text":"While Pen Name’s work stands out, their website was dated, static, and understated to a fault, a stark contrast to the impact they’re known for. We partnered with Pen Name to create a digital presence that matches the caliber of their output. The goal: build a site as confident and intentional as the work it showcases."}],"markDefs":[],"style":"normal"}],"title":"The Project"},{"_key":"1beea1f92537","_type":"workDouble45","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1087848657-1440p.mp4","vimeoId":"1087848657"},"rightMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1088830827","url":"/ext/vimeo-img/2021138529-ab1a2e04e94192d2fe4f4dcaadbaae00da3b2a418ad1d945b558ec2577ed6e63-d.jpg"},"video":"/ext/video/1088830827-1440p.mp4","vimeoId":"1088830827"}},{"_key":"313f9deced29","_type":"workTextBlock","content":[{"_key":"37855c1c342f","_type":"block","children":[{"_key":"ce52184e326a0","_type":"span","marks":[],"text":"Our job wasn’t to make them louder. It was to make them undeniable. We built a site that mirrors the way they operate: sharp, fast, and deeply intentional. Every interaction is considered. Every detail earns its place. From the navigation to the motion to the typography, nothing is added without purpose. The site doesn’t try to impress, it simply reflects the confidence of a team that knows exactly what they’re doing. It’s a platform that speaks clearly, works seamlessly, and holds up to the level of names that trust Pen Name with their reputation."}],"markDefs":[],"style":"normal"}],"title":"A Crafted Experience"},{"_key":"46eb4bdbb634","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/1087848671-2160p.mp4","videoAdaptive":null,"vimeoId":"1087848671"}},{"_key":"6122c91aeb1d","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-f786728db923f1f71a1e720a48e5aca57a4988a7-2532x3165-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-50a8c4196841b159076749f74e279d198c8cf34c-1680x2100-webp","_type":"reference"}},"mediaType":"image"}}]},"params":{"slug":"pen-name"},"globalSettings":{"_createdAt":"2024-10-22T20:44:16Z","_id":"globalSettings","_rev":"6p8vZffvPAFD6E6aSNtKo2","_type":"globalSettings","_updatedAt":"2025-04-24T03:14:08Z","footer":{"email":"yuxuen1993@gmail.com","infoPages":[{"_key":"841d1d64f5ea","_type":"pageLink","path":"/careers","title":"Collaborate"},{"_key":"3ffc11fd5737","_type":"pageLink","path":"/contact","title":"Contact Us"}],"phoneNumber":"+60 11-6368 3842","socials":[]}},"draftMode":false,"seo":{"title":"Pen Name — Gimetry Studio","description":"Gimetry Studio crafted an sleek and intentional website design for Pen Name Consulting that matches the caliber of their work and clients.","image":{"_type":"image","asset":{"_ref":"image-53cc47641f767c4b3eaf084d104b81b230b8e7ba-1200x600-jpg","_type":"reference"}},"keywords":"","schemaMarkup":null},"token":""},"__N_SSG":true}