{"pageProps":{"work":{"_createdAt":"2026-02-23T19:33:33Z","_id":"7f0725d0-d503-4d16-bf3e-f6e5385c89d6","_rev":"RT1ayPv3t1OpoFCZh5OHXs","_system":{"base":{"id":"7f0725d0-d503-4d16-bf3e-f6e5385c89d6","rev":"5rEo4eho0WPFec3f7amo86"}},"_type":"work","_updatedAt":"2026-07-06T18:17:02Z","metaDescription":"Lumina Fintech is an AI loan platform in Malaysia offering smart loan matching, AI credit assessment, and loan eligibility checks for personal and SME borrowers. Website and product experience designed and built by Gimetry Studio.","metaTitle":"Lumina Fintech","nextProject":{"_createdAt":"2026-03-05T21:19:31Z","_id":"836caedf-c8f1-4283-a490-188eba4468d0","_rev":"tTlXFWaLzsE9XjbfIDUzdQ","_system":{"base":{"id":"836caedf-c8f1-4283-a490-188eba4468d0","rev":"ffOA5dJsB1rud0qrXH5bhC"}},"_type":"work","_updatedAt":"2026-07-06T18:19:19Z","nextProject":{"_ref":"2baa5644-27c3-4053-b176-b5c427b188c9","_type":"reference"},"ogImage":{"_type":"image","asset":{"_ref":"image-e67fd8ab0337f60732f9d8907b419134351aa22b-3352x2235-png","_type":"reference"}},"orderRank":"0|0ldi0e:","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"buysiders-club"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1174109130","url":"/ext/vimeo-img/2134601625-d69627838019bf3319bef97c3572006bce20b177ccdeadb2a8914549f45c8ec6-d.jpg"},"video":"/ext/video/1174109130-2160p.mp4","videoAdaptive":null,"vimeoId":"1174109130"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-e67fd8ab0337f60732f9d8907b419134351aa22b-3352x2235-png","_type":"reference"}},"mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1173436163","url":"/ext/vimeo-img/2133689896-5ddf997d68a5df2b131f14e5a0ef66fca8eb4b2c08b9bbc2305306a7a73f6b5d-d.jpg"},"video":"/ext/video/1173436163-1080p.mp4","videoAdaptive":null,"vimeoId":"1173436163"},"thumbnailExcerpt":"Matchday motion design for Malaysia’s most decorated club.","title":"Johor Darul Ta’zim","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#fcf8ef"},"buttonColor":"orange","heroMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-e67fd8ab0337f60732f9d8907b419134351aa22b-3352x2235-png","_type":"reference"}},"mediaType":"image"},"sectionContent":[{"_key":"0241330be7e3","_type":"block","children":[{"_key":"cc81933a14c10","_type":"span","marks":[],"text":"Johor Darul Ta’zim is Malaysia’s most decorated football club, and matchday at the Sultan Ibrahim Stadium is a show in its own right. We created the club’s event-day motion visuals — high-energy LED graphics that run across the stadium surfaces and social channels, from pre-match build-up to the final whistle."}],"markDefs":[],"style":"normal"}],"servicesList":["LED Motion Design","Motion Graphics","Social Cuts"],"textColor":"darkGray","websiteURL":"https://gimetry.online/projects/jdt-johor-darul-tazim/"},"workModules":[{"_key":"7de17539f638","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1170817489","url":"/ext/vimeo-img/2130094834-ecd1f161703b932168e7b2f66681eacb2578b46d3963549c6b85b90d0c801a89-d.jpg"},"video":"/ext/video/1170817489-2160p.mp4","videoAdaptive":null,"vimeoId":"1170817489"}},{"_key":"bf1102daacfa","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-5f568fe3e73a8e7cbf618901cad7281a0233a5c1-1680x2100-png","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-57efb8c732886dd8187bb1786c9c413410284f23-1680x2100-png","_type":"reference"}},"mediaType":"image"}},{"_key":"bfedd9695e38","_type":"workTextBlock","content":[{"_key":"4b07729816ae","_type":"block","children":[{"_key":"cbffeb72bb130","_type":"span","marks":[],"text":"Modular motion scenes form the backbone of the system, each built with safe zones that keep the club crest and partner marks readable at any scale — from massive LED ribbons to a phone screen. Aggressive, high-energy movement drives the stadium atmosphere, while venue-ready loop packages run cleanly through pre-match and halftime with no visible jumps. The same scenes cut down into social clips, giving the media team fast deployment on match day without losing the premium feel."}],"markDefs":[],"style":"normal"}],"title":"The Motion System"},{"_key":"e42fc4602f7c","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1170817566","url":"/ext/vimeo-img/2130094921-e21f0ef3c512fd9afc415db588c56b6319e8e050635f8d9c9599f7b1c556fd8c-d.jpg"},"video":"/ext/video/1170817566-2160p.mp4","videoAdaptive":null,"vimeoId":"1170817566"}},{"_key":"5a8934fcff69","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-9c7e1729775b370301ac99fb958671fc65953a34-1678x2098-gif","_type":"reference"}},"mediaType":"gif"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-48d06f1a36c5cf405ee1485ba9b14dc60df55ebc-1680x2100-png","_type":"reference"}},"mediaType":"gif"}},{"_key":"fc03c63433c4d44b676aadb7fbb233d7","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-82bccf8d039d144718dc596c1d3eaa2130e505c7-3408x1918-png","_type":"reference"}},"mediaType":"image"}}]},"ogImage":{"_type":"image","asset":{"_ref":"image-3df7626eee0f97d87a5cfd2885efb99a6b00eb67-2400x1260-jpg","_type":"reference"}},"orderRank":"0|052903:","ourProcess":{"content":[{"_key":"8cf880859319","_type":"block","children":[{"_key":"6e780e9406d4","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"2451d8799682","_type":"block","children":[{"_key":"8419f5415d56","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"hideProcessButton":true},"slug":{"_type":"slug","current":"hamilton"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1195724705","url":"/ext/vimeo-img/2161656966-a3a03e7217f877b7c48c5d2ed6959162dc7ee029fe0d36f51f6c1324f6cbc48d-d.jpg"},"video":"/ext/video/1195724705-720p.mp4","videoAdaptive":null,"vimeoId":"1195724705"},"thumbnailCover":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1172349764","url":"/ext/vimeo-img/2132157640-668c592a2c65e60b1e32f677454b8a881d84fba24cde654a2e4786cdff088a4a-d.jpg"},"video":"/ext/video/1172349764-2160p.mp4","videoAdaptive":null,"vimeoId":"1172349764"},"thumbnailExcerpt":"An AI loan platform that explains every recommendation.","title":"Lumina Fintech","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#c9c9c9"},"buttonColor":"black","heroMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1172349764","url":"/ext/vimeo-img/2132157640-668c592a2c65e60b1e32f677454b8a881d84fba24cde654a2e4786cdff088a4a-d.jpg"},"video":"/ext/video/1172349764-2160p.mp4","videoAdaptive":null,"vimeoId":"1172349764"},"sectionContent":[{"_key":"47de3f5d3442","_type":"block","children":[{"_key":"764326b922c50","_type":"span","marks":[],"text":"Lumina Fintech is an AI loan platform in Malaysia that pairs smart loan matching with fair, explainable AI credit assessment for personal and SME borrowers. From strategy to launch, we designed and built a digital product experience that makes complex lending decisions feel clear, trustworthy, and effortless."}],"markDefs":[],"style":"normal"}],"servicesList":["Web Design","Product Experience","Development"],"textColor":"darkGray","websiteURL":"https://luminafintech.com/"},"workModules":[{"_key":"256bc3cc4d4e","_type":"workTextBlock","content":[{"_key":"240c818d82ae","_type":"block","children":[{"_key":"6df3e8f2fbb60","_type":"span","marks":[],"text":"In an industry crowded with fine print and opaque approvals, Lumina set out to stand apart. The challenge was to translate a serious financial product into a visual language that felt trustworthy for everyday borrowers while still expressing a modern, innovation-led brand tone."}],"markDefs":[],"style":"normal"},{"_key":"36e02912d4be","_type":"block","children":[{"_key":"f417cde77451","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"d7c68eab2d7f","_type":"block","children":[{"_key":"359c6741e0d80","_type":"span","marks":[],"text":"Lending traditionally hides behind jargon and asks for trust up front. Lumina takes the opposite view: borrowers deserve to understand every recommendation before they commit. From AI credit assessment to loan eligibility checks, the product explains itself in plain language at every step. That conviction became the foundation of the entire experience: clarity first."}],"markDefs":[],"style":"normal"}],"title":"Clarity First."},{"_key":"60cc46acb0fc","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1172350814","url":"/ext/vimeo-img/2132162057-1c25dcb110ce47ea57a70579388c1ec442715c9c79a47f56b080e2d9e11368fd-d.jpg"},"video":"/ext/video/1172350814-2160p.mp4","videoAdaptive":null,"vimeoId":"1172350814"}},{"_key":"b5c2bf7274d0","_type":"workTextBlock","content":[{"_key":"d54b8bcfea2c","_type":"block","children":[{"_key":"dac1c02448a90","_type":"span","marks":[],"text":"A scalable framework of reusable sections anchors the experience, giving every feature page a consistent rhythm. Clear CTA hierarchy guides borrowers toward eligibility checks, while restrained motion accents add energy without undermining trust. The interface itself is clean, balanced, and dependable."}],"markDefs":[],"style":"normal"}],"title":"AI Automation"},{"_key":"6f6b6ac53d7f","_type":"workDouble45","leftMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1172349989","url":"/ext/vimeo-img/2132157929-bdc16e8da06b96235534154ae8a50f75ea67a088e4038a735790a3202b8d2be0-d.jpg"},"video":"/ext/video/1172349989-2160p.mp4","videoAdaptive":null,"vimeoId":"1172349989"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-812004c1601489d74e390069658cacc722dcdac6-2880x3840-png","_type":"reference"}},"mediaType":"image"}},{"_key":"606c96438de3","_type":"workTextBlock","content":[{"_key":"701fec56a414","_type":"block","children":[{"_key":"978f8280936d0","_type":"span","marks":[],"text":"The website goes beyond marketing pages and behaves like a working product. Live match scores, a loan comparison dashboard, and a suite of six financial calculators — from affordability to stamp duty — give borrowers real answers before they ever apply."}],"markDefs":[],"style":"normal"},{"_key":"2ac711efc83d","_type":"block","children":[{"_key":"4e6b666667df","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"bef87fd29b1f","_type":"block","children":[{"_key":"b473005d8cd6","_type":"span","marks":[],"text":"As users move from eligibility checks to lender comparisons, the mobile-first interface stays consistent throughout, reinforcing Lumina's promise that every recommendation is transparent and reviewable."}],"markDefs":[],"style":"normal"}],"title":"Website"},{"_key":"73a1aa7755fd","_type":"workSingleImage","capWidth":true,"media":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1172350033","url":"/ext/vimeo-img/2132158000-740c1bad9ea337a39c280f353d741238ac760668a619a1c7e1ef7b38c3a6b7d1-d.jpg"},"video":"/ext/video/1172350033-2160p.mp4","videoAdaptive":null,"vimeoId":"1172350033"}},{"_key":"8464d336d607","_type":"workTextBlock","capWidth":false,"content":[{"_key":"d57f59d653d1","_type":"block","children":[{"_key":"14c9106048cb0","_type":"span","marks":[],"text":"Dense feature communication was a core constraint: the system had to support future feature pages without redesigning from scratch. Reusable sections, a disciplined type scale, and consistent component behaviour keep the product UI and campaign visuals in perfect alignment."}],"markDefs":[],"style":"normal"},{"_key":"1c70048d7852","_type":"block","children":[{"_key":"aaa97cacd6b3","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"1487abdb4eeb","_type":"block","children":[{"_key":"54537b583552","_type":"span","marks":[],"text":"The result is a digital presence that grows with the platform — as considered and dependable as the product itself."}],"markDefs":[],"style":"normal"}],"title":"Built to Scale"},{"_key":"7e2778ce5a4c","_type":"workDouble45","capWidth":false,"leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-7976b63a1a3ca1a8ba0e703087a9d7b92c58acf9-2160x2880-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-4f079b28ec3bf12998c3d1f89edc656b2b3c5aa5-2160x2880-webp","_type":"reference"}},"mediaType":"image"}},{"_key":"0858e1f3ad54","_type":"workSingleImage","capWidth":false,"media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-9a1847e09dc353823dfb79aca6320c1a803077e5-3840x2160-webp","_type":"reference"}},"mediaType":"image"}}]},"params":{"slug":"hamilton"},"globalSettings":{"_createdAt":"2024-10-22T20:44:16Z","_id":"globalSettings","_rev":"6p8vZffvPAFD6E6aSNtKo2","_type":"globalSettings","_updatedAt":"2025-04-24T03:14:08Z","footer":{"email":"yuxuen1993@gmail.com","infoPages":[{"_key":"841d1d64f5ea","_type":"pageLink","path":"/careers","title":"Collaborate"},{"_key":"3ffc11fd5737","_type":"pageLink","path":"/contact","title":"Contact Us"}],"phoneNumber":"+60 11-6368 3842","socials":[]}},"draftMode":false,"seo":{"title":"Lumina Fintech — Gimetry Studio","description":"Lumina Fintech is an AI loan platform in Malaysia offering smart loan matching, AI credit assessment, and loan eligibility checks for personal and SME borrowers. Website and product experience designed and built by Gimetry Studio.","image":{"_type":"image","asset":{"_ref":"image-3df762