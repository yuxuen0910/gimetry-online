{"pageProps":{"work":{"_createdAt":"2025-02-14T23:52:18Z","_id":"c4c74034-6473-4742-8d16-597b62603a20","_rev":"RT1ayPv3t1OpoFCZh5mUNf","_system":{"base":{"id":"c4c74034-6473-4742-8d16-597b62603a20","rev":"h53se4Pc2uw77GU24llycc"}},"_type":"work","_updatedAt":"2026-07-06T20:56:02Z","metaDescription":"Montfort Capital — private credit financial branding and website design by Gimetry Studio","nextProject":{"_createdAt":"2025-02-14T22:54:38Z","_id":"8064c316-b8ab-4f11-95a6-0bfb03866579","_rev":"h53se4Pc2uw77GU24lXx2w","_system":{"base":{"id":"8064c316-b8ab-4f11-95a6-0bfb03866579","rev":"wt0AlHOj0CfVHYplye0nuG"}},"_type":"work","_updatedAt":"2026-07-06T18:59:11Z","footerGif":{"_type":"image","asset":{"_ref":"image-a98f74d4b2c43e881db4708c245d3ddd6646dc0c-500x375-gif","_type":"reference"}},"nextProject":{"_ref":"b5f8b6f5-4dd9-40ff-ab37-ec4cd13415c8","_type":"reference"},"orderRank":"0|10000y:r","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"freshcap-mushrooms"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1083693863","url":"/ext/vimeo-img/2014949803-7b394fff0192f58e8e337141b1c4803d7725b895c269bdc10938a48f9916059a-d.jpg"},"video":"/ext/video/1083700231-720p.mp4","videoAdaptive":null,"vimeoId":"1083700231"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-fbd476bb8bc17d66f93555eda0fc0a4923f43af7-3200x1800-jpg","_type":"reference"}},"mediaType":"image"},"thumbnailExcerpt":"Turning a local mushroom brand into an industry leader.","title":"FreshCap Mushrooms","workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ebeae9"},"heroMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-fbd476bb8bc17d66f93555eda0fc0a4923f43af7-3200x1800-jpg","_type":"reference"}},"mediaType":"image"},"sectionContent":[{"_key":"257c265ab0e8","_type":"block","children":[{"_key":"6b457f90e0cf0","_type":"span","marks":[],"text":"FreshCap is on a mission to bring medicinal mushroom supplements to the world. We developed a distinct identity that helped take the brand from a small supplier to an 8-figure industry leader."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand Identity","Packaging","Web Design","Amazon A+"],"websiteURL":"https://freshcap.com/"},"workModules":[{"_key":"6ede6c8355b3","_type":"workDoubleImage","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/677839275-720p.mp4"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/677826950-720p.mp4","vimeoId":"677839275"}},{"_key":"69c23d9e73cd","_type":"workTextBlock","content":[{"_key":"2a9a4eed6b18","_type":"block","children":[{"_key":"166534fe1d520","_type":"span","marks":[],"text":"From the start we knew that FreshCap was going to be something special. The brand had to be functional and informative, but we also saw an opportunity to make a splash with something bold and unexpected. Our collaborative approach allowed the founders' personalities to shine through, guiding us through the fantastic world of fungi to create something energetic, authentic, and with tons of personality."}],"markDefs":[],"style":"normal"}],"title":"Building a functional foundation"},{"_key":"6d7b9e368e72","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-68d40479c37a178f91fc515eff5de7a589e94927-1580x1581-jpg","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-d19f718a0e5656bec56c9c2b36e797a1cdc8e5d0-1580x1581-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"92cf560637d7","_type":"workTextBlock","content":[{"_key":"e373ffcada33","_type":"block","children":[{"_key":"28ca3602f5ee0","_type":"span","marks":[],"text":"Search for Functional Mushrooms on Amazon and you'll be inundated by a never ending wall of brown, black, and beige. By contrast, our colour and typography choices were made to reflect the various mushroom species, while steering clear of anything too outwardly muddy. Organic shapes and bold eye-catching visual treatments combine to create a brand that can't help but draw you in. \n\nBonus? We got to discover the awesome world of functional mushrooms for ourselves. We're now full-time fungi fans at Gimetry Studio HQ."}],"markDefs":[],"style":"normal"}],"title":"The FreshCap difference"},{"_key":"d4aa9dbdae04","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/677826896-1440p.mp4","videoAdaptive":null}},{"_key":"f4c8bc0e5721","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-6758dd0396dd5b29796ce9070d41ea4a99614e2a-1562x2000-jpg","_type":"reference"}},"mediaType":"video","video":"/ext/video/684468598-1080p.mp4","videoAdaptive":null},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-6ab00df819c687ced45283325384116906da63b6-1580x1581-jpg","_type":"reference"}},"mediaType":"image"}}]},"orderRank":"0|100012:","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"monfort-capital"},"thumbnailContent":{"_type":"media","mediaType":"video","video":"/ext/video/1083700295-720p.mp4","videoAdaptive":null,"vimeoId":"1083700295"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-13dbf788147da0c02c46a9910bb3fde8b2c51547-1320x880-jpg","_type":"reference"}},"mediaType":"video","video":"/ext/video/788088899-1080p.mp4","videoAdaptive":null,"vimeoId":"788088899"},"thumbnailExcerpt":"Designing a financial disruptor.","title":"Montfort Capital","workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ebeae9"},"heroMedia":{"_type":"media","mediaType":"video","video":"/ext/video/788450671-1080p.mp4","videoAdaptive":null,"vimeoId":"788450671"},"sectionContent":[{"_key":"3d0c8ec6b27b","_type":"block","children":[{"_key":"809a8ce17a140","_type":"span","marks":[],"text":"Montfort Capital is building a future where private credit is accessible to everyone. They needed a bold identity to match their bold vision."}],"markDefs":[],"style":"normal"}],"servicesList":["Naming","Brand Identity","Web Design","Print"],"websiteURL":"https://montfortcapital.com/"},"workModules":[{"_key":"dd3935e5dc25","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-0148660339a16cf40d3b3ef4607f04d84a1bb63e-3200x2000-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"63ee2bb7ebb2","_type":"workTextBlock","content":[{"_key":"7f82cf7c6fd3","_type":"block","children":[{"_key":"9a634888fab10","_type":"span","marks":[],"text":"Montfort came to us with a blank slate: A nameless portfolio of companies making private credit accessible to investors."}],"markDefs":[],"style":"normal"},{"_key":"ee33b6391dd9","_type":"block","children":[{"_key":"8e99f1673ab60","_type":"span","marks":[],"text":"Our challenge was to create a unifying brand that felt trusted, timeless, and familiar, while establishing itself as a modern disrupter to an archaic industry."}],"markDefs":[],"style":"normal"}],"title":"What's in a name?"},{"_key":"037a7bb5e556","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-7d5d3d1e793b6cdf2f9d97ab2ddca0970f849723-3200x1801-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"f5639b1f5e47","_type":"workTextBlock","content":[{"_key":"7fa201da2505","_type":"block","children":[{"_key":"ec1c49dc33220","_type":"span","marks":[],"text":"It was clear from the start that bringing together these disparate pieces required more than just a name and a logo."}],"markDefs":[],"style":"normal"},{"_key":"198cd39fe5f7","_type":"block","children":[{"_key":"907adc2b000f0","_type":"span","marks":[],"text":"So we began to imagine Montfort not as a brand, but a destination. A world of aspirational spaces, powered by smart investing decisions, that invite you to step inside and create your own stories."}],"markDefs":[],"style":"normal"},{"_key":"e505aeb690c9","_type":"block","children":[{"_key":"ea61bd8d1459","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"title":"Building the Montfort story"},{"_key":"6eb7187a9a7c","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-a94b1813e73f96db31025e05a3e3b081b57f8bb4-1600x1600-jpg","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/788088941-1080p.mp4","videoAdaptive":null}},{"_key":"727ae1e8a639","_type":"workTextBlock","content":[{"_key":"6458126fcad8","_type":"block","children":[{"_key":"2a23b3c6eb710","_type":"span","marks":[],"text":"Inspired by broadsheets, ledgers, and printed reports, digital touchpoints nod to physical counterparts, creating a cohesive brand experience whether you’re on a boat or in the boardroom."}],"markDefs":[],"style":"normal"},{"_key":"c048557829ce","_type":"block","children":[{"_key":"9a95f0737f6d","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"title":"Putting stock in the brand"},{"_key":"ed74635e2cd4","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-1d24ed98215fd78b482c3ef735345d805a1fba7e-3200x2061-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"083a957f9232","_type":"workDoubleImage","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/788088951-1080p.mp4","videoAdaptive":null},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-bc62584d034058cee015e48e822ef16b2bdf25af-1600x1600-jpg","_type":"reference"}},"mediaType":"image"}}]},"params":{"slug":"monfort-capital"},"globalSettings":{"_createdAt":"2024-10-22T20:44:16Z","_id":"globalSettings","_rev":"6p8vZffvPAFD6E6aSNtKo2","_type":"globalSettings","_updatedAt":"2025-04-24T03:14:08Z","footer":{"email":"yuxuen1993@gmail.com","infoPages":[{"_key":"841d1d64f5ea","_type":"pageLink","path":"/careers","title":"Collaborate"},{"_key":"3ffc11fd5737","_type":"pageLink","path":"/contact","title":"Contact Us"}],"phoneNumber":"+60 11-6368 3842","socials":[]}},"draftMode":false,"seo":{"title":"Montfort Capital — Gimetry Studio","description":"Montfort Capital — private credit financial branding and website design by Gimetry Studio","image":"","keywords":"","schemaMarkup":null},"token":""},"__N_SSG":true}