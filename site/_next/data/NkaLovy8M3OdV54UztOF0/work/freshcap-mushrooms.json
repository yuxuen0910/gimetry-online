{"pageProps":{"work":{"_createdAt":"2025-02-14T22:54:38Z","_id":"8064c316-b8ab-4f11-95a6-0bfb03866579","_rev":"h53se4Pc2uw77GU24lXx2w","_system":{"base":{"id":"8064c316-b8ab-4f11-95a6-0bfb03866579","rev":"wt0AlHOj0CfVHYplye0nuG"}},"_type":"work","_updatedAt":"2026-07-06T18:59:11Z","footerGif":{"_type":"image","asset":{"_ref":"image-a98f74d4b2c43e881db4708c245d3ddd6646dc0c-500x375-gif","_type":"reference"}},"nextProject":{"_createdAt":"2024-12-06T19:50:05Z","_id":"53b0139a-6051-4eb6-84b5-ce8434cf91fc","_rev":"RT1ayPv3t1OpoFCZh5cASH","_system":{"base":{"id":"53b0139a-6051-4eb6-84b5-ce8434cf91fc","rev":"wt0AlHOj0CfVHYplydyAUf"}},"_type":"work","_updatedAt":"2026-07-06T19:22:55Z","nextProject":null,"orderRank":"0|10001h:i","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"fresh-nutrition"},"thumbnailContent":{"_type":"media","mediaType":"video","video":"/ext/video/1083960299-720p.mp4","videoAdaptive":null,"vimeoId":"1083960299"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-b184f363a8151924db8be22922277b231070a1e4-2640x1760-webp","_type":"reference"}},"mediaType":"image","thumbnail":{"alt":"Thumbnail for Vimeo video 1013658735","url":"/ext/vimeo-img/1931683717-4d151b697afb3055ccffecc2f1831303f2d27b9021079a11ef9a28f332b5279e-d.jpg"},"video":"/ext/video/1013658735-2160p.mp4","vimeoId":"1013658735"},"thumbnailExcerpt":"Cutting out costly middlemen with direct-to-consumer supplements.","title":"Fresh Nutrition","workHeroSection":{"backgroundColor":{"label":"Custom","value":"#dbe750"},"heroMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1013658735-1440p.mp4","videoAdaptive":null},"sectionContent":[{"_key":"bb821567dc26","_type":"block","children":[{"_key":"6e99c0b6d0f90","_type":"span","marks":[],"text":"As the trusted ingredient supplier for leading supplement brands, Fresh Nutrition knows a thing or two about quality. Now, they're cutting out the middlemen and making premium nutrition more affordable for everyone."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand Strategy","Brand Identity","Packaging","Web Design","Amazon A+","Copywriting"],"websiteURL":"https://fresh-nutrition.com"},"workModules":[{"_key":"5985e90f5922","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","alt":"FN Process","asset":{"_ref":"image-79ad4fb0e5b72665fc4f84703c3b54d09095546a-1580x1580-png","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1013338794-2160p.mp4","videoAdaptive":null}},{"_key":"b53b43167316","_type":"workTextBlock","content":[{"_key":"67144170b1f7","_type":"block","children":[{"_key":"97f2dcaf60770","_type":"span","marks":[],"text":"After seeing strong sales during the vitamin-fuelled Covid days, Fresh Nutrition’s market footprint had started to plateau. They had a strong Amazon presence and great product. But a fragmented and confusing brand with little creative oversight meant that customer acquisition was dropping off. It was time for a refresh."}],"markDefs":[],"style":"normal"}],"title":"Going back to basics"},{"_key":"6b6560488d54","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","alt":"FN Product with oranges","asset":{"_ref":"image-b971e6d0b6750bed0d3108fbdade04e043bdebfa-1580x1580-png","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","alt":"FN Design book","asset":{"_ref":"image-bd3978b94e62687e39f74d63204e30168778f4e4-1580x1580-png","_type":"reference"}},"mediaType":"image"}},{"_key":"bfae9ced2d90","_type":"workTextBlock","content":[{"_key":"69fd2390cf58","_type":"block","children":[{"_key":"b1a29bb45f9b0","_type":"span","marks":[],"text":"Utilizing our embedded partnership process, the Gimetry Studio team led Fresh Nutrition through a comprehensive repositioning and brand overhaul — including a complete rebuild of their AI Automation website. After aligning on a strategy, we rolled out copywriting, design, packaging and marketing strategy for 35+ flagship supplement products."}],"markDefs":[],"style":"normal"}],"title":"A comprehensive rebrand"},{"_key":"d1967fc17747","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","alt":"FN Family Photo","asset":{"_ref":"image-cc57edbd8aeb77bbc2694d176a02f33bd0eb9e35-3200x1800-png","_type":"reference"}},"mediaType":"image"}},{"_key":"ea1525d0b0be","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","alt":"FN Tote","asset":{"_ref":"image-404bdadf2da3827a6809cc4e8f039fe54a1d2a0a-2160x2159-jpg","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1013338821-2160p.mp4","videoAdaptive":null}},{"_key":"f4a7d486daec","_type":"workTextBlock","content":[{"_key":"f2fff20b6e9d","_type":"block","children":[{"_key":"8dbc72d52f8c0","_type":"span","marks":[],"text":"The rebrand gave the Fresh Nutrition team an ownable brand identity, built around their core strengths of direct-to-you simplicity and clarity. The scalable design system helps products stand out in a crowded marketplace, and a close working relationship between Gimetry Studio and product managers continues to enable rapid product innovation and quick go-to-market rollouts, helping the brand stay ahead of the competition."}],"markDefs":[],"style":"normal"},{"_key":"c5bfce26f991","_type":"block","children":[{"_key":"8fe70b9879760","_type":"span","marks":[],"text":"Now that’s Fresh."}],"markDefs":[],"style":"normal"},{"_key":"e18b987837a8","_type":"block","children":[{"_key":"2de9dce466c80","_type":"span","marks":[],"text":"\n"}],"markDefs":[],"style":"normal"}],"title":"Bringing it all together"},{"_key":"8cf21a10023f","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","alt":"From us to you","asset":{"_ref":"image-b2fb023f4d93e81ddeb78a2976e1d86855d38c78-3200x1800-png","_type":"reference"}},"mediaType":"image"}}]},"orderRank":"0|10000y:r","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"freshcap-mushrooms"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1083693863","url":"/ext/vimeo-img/2014949803-7b394fff0192f58e8e337141b1c4803d7725b895c269bdc10938a48f9916059a-d.jpg"},"video":"/ext/video/1083700231-720p.mp4","videoAdaptive":null,"vimeoId":"1083700231"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-fbd476bb8bc17d66f93555eda0fc0a4923f43af7-3200x1800-jpg","_type":"reference"}},"mediaType":"image"},"thumbnailExcerpt":"Turning a local mushroom brand into an industry leader.","title":"FreshCap Mushrooms","workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ebeae9"},"heroMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-fbd476bb8bc17d66f93555eda0fc0a4923f43af7-3200x1800-jpg","_type":"reference"}},"mediaType":"image"},"sectionContent":[{"_key":"257c265ab0e8","_type":"block","children":[{"_key":"6b457f90e0cf0","_type":"span","marks":[],"text":"FreshCap is on a mission to bring medicinal mushroom supplements to the world. We developed a distinct identity that helped take the brand from a small supplier to an 8-figure industry leader."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand Identity","Packaging","Web Design","Amazon A+"],"websiteURL":"https://freshcap.com/"},"workModules":[{"_key":"6ede6c8355b3","_type":"workDoubleImage","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/677839275-720p.mp4"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/677826950-720p.mp4","vimeoId":"677839275"}},{"_key":"69c23d9e73cd","_type":"workTextBlock","content":[{"_key":"2a9a4eed6b18","_type":"block","children":[{"_key":"166534fe1d520","_type":"span","marks":[],"text":"From the start we knew that FreshCap was going to be something special. The brand had to be functional and informative, but we also saw an opportunity to make a splash with something bold and unexpected. Our collaborative approach allowed the founders' personalities to shine through, guiding us through the fantastic world of fungi to create something energetic, authentic, and with tons of personality."}],"markDefs":[],"style":"normal"}],"title":"Building a functional foundation"},{"_key":"6d7b9e368e72","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-68d40479c37a178f91fc515eff5de7a589e94927-1580x1581-jpg","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-d19f718a0e5656bec56c9c2b36e797a1cdc8e5d0-1580x1581-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"92cf560637d7","_type":"workTextBlock","content":[{"_key":"e373ffcada33","_type":"block","children":[{"_key":"28ca3602f5ee0","_type":"span","marks":[],"text":"Search for Functional Mushrooms on Amazon and you'll be inundated by a never ending wall of brown, black, and beige. By contrast, our colour and typography choices were made to reflect the various mushroom species, while steering clear of anything too outwardly muddy. Organic shapes and bold eye-catching visual treatments combine to create a brand that can't help but draw you in. \n\nBonus? We got to discover the awesome world of functional mushrooms for ourselves. We're now full-time fungi fans at Gimetry Studio HQ."}],"markDefs":[],"style":"normal"}],"title":"The FreshCap difference"},{"_key":"d4aa9dbdae04","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/677826896-1440p.mp4","videoAdaptive":null}},{"_key":"f4c8bc0e5721","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-6758dd0396dd5b29796ce9070d41ea4a99614e2a-1562x2000-jpg","_type":"reference"}},"mediaType":"video","video":"/ext/video/684468598-1080p.mp4","videoAdaptive":null},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-6ab00df819c687ced45283325384116906da63b6-1580x1581-jpg","_type":"reference"}},"mediaType":"image"}}]},"params":{"slug":"freshcap-mushrooms"},"globalSettings":{"_createdAt":"2024-10-22T20:44:16Z","_id":"globalSettings","_rev":"6p8vZffvPAFD6E6aSNtKo2","_type":"globalSettings","_updatedAt":"2025-04-24T03:14:08Z","footer":{"email":"yuxuen1993@gmail.com","infoPages":[{"_key":"841d1d64f5ea","_type":"pageLink","path":"/careers","title":"Collaborate"},{"_key":"3ffc11fd5737","_type":"pageLink","path":"/contact","title":"Contact Us"}],"phoneNumber":"+60 11-6368 3842","socials":[]}},"draftMode":false,"seo":{"title":"FreshCap Mushrooms — Gimetry Studio","description":"","image":"","keywords":"","schemaMarkup":null},"token":""},"__N_SSG":true}