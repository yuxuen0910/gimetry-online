{"pageProps":{"work":{"_createdAt":"2025-02-14T22:54:38Z","_id":"8064c316-b8ab-4f11-95a6-0bfb03866579","_rev":"h53se4Pc2uw77GU24lXx2w","_system":{"base":{"id":"8064c316-b8ab-4f11-95a6-0bfb03866579","rev":"wt0AlHOj0CfVHYplye0nuG"}},"_type":"work","_updatedAt":"2026-07-06T18:59:11Z","footerGif":{"_type":"image","asset":{"_ref":"image-a98f74d4b2c43e881db4708c245d3ddd6646dc0c-500x375-gif","_type":"reference"}},"nextProject":{"_createdAt":"2025-04-30T21:54:19Z","_id":"b5f8b6f5-4dd9-40ff-ab37-ec4cd13415c8","_rev":"tTlXFWaLzsE9XjbfIDbjXk","_system":{"base":{"id":"b5f8b6f5-4dd9-40ff-ab37-ec4cd13415c8","rev":"NMtmX848WKOgxaslcAVumU"}},"_type":"work","_updatedAt":"2026-07-06T18:55:25Z","nextProject":{"_ref":"d83f6c8d-7982-4026-8590-251f8f5942d1","_type":"reference"},"orderRank":"0|10000x:f","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"litquidity"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1082961602","url":"/ext/vimeo-img/2014058196-fd2dc05f5d7b049ea37f73b2fbeb88b01869d8848e3efc3f1169c80388da598b-d.jpg"},"video":"/ext/video/1083700266-720p.mp4","videoAdaptive":null,"vimeoId":"1083700266"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-84544fee89a0fce98fe375dbae3564ed7ae760e2-3840x2560-webp","_type":"reference"}},"mediaType":"image"},"thumbnailExcerpt":"Rebranding the Internet's dankest financial news source.","title":"Litquidity","topSecret":false,"workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ecf1ee"},"heroMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-7433a68b936129250f327db1e23c790951196058-3408x2272-webp","_type":"reference"}},"mediaType":"image"},"sectionContent":[{"_key":"bbae32089c30","_type":"block","children":[{"_key":"e3e410232a970","_type":"span","marks":[],"text":"Litquidity isn’t just a finance meme account, it’s a media powerhouse with over 2.5 million followers, a booming newsletter (ExecSum), a podcast network, and a syndicate of private investors. As their influence grew, so did the need for a cohesive digital identity that matched the sophistication of their content. That's where we came in."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand Identity","Web Design"],"websiteURL":"https://litquidity.co/"},"workModules":[{"_key":"2e8e51dd79f4","_type":"workTextBlock","content":[{"_key":"ec715beb6dbd","_type":"block","children":[{"_key":"86114597c4e60","_type":"span","marks":[],"text":"Gimetry Studio partnered with Litquidity to reimagine their brand system and create a unified web presence, one that balances edge and polish, and gives their content the credibility it deserves. We developed a flexible visual language that could stretch across platforms while still feeling unmistakably “Lit.” Clean typography, an editorial-inspired layout system, and subtle nods to financial vernacular formed the foundation."}],"markDefs":[],"style":"normal"}],"title":"Bringing the market to the masses"},{"_key":"d82f0113f64b","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-a827555afdf55eb678e703117a4deb931187ad54-3840x2161-webp","_type":"reference"}},"mediaType":"video","video":"/ext/video/1081906204-2160p.mp4","videoAdaptive":null}},{"_key":"8e6c63401b34","_type":"workDouble45","leftMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1081906179","url":"/ext/vimeo-img/2012783939-f2e4d896fd3f5c73539820c09b88354146b2f04cd466cb6156d9f73c43a48742-d.jpg"},"video":"/ext/video/1081906179-1440p.mp4","vimeoId":"1081906179"},"rightMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1081906187","url":"/ext/vimeo-img/2012783982-8f1d9fee7466557d2f5dc69797a56a60d7c7de75fa9aee68486431e30523446b-d.jpg"},"video":"/ext/video/1081906187-1440p.mp4","vimeoId":"1081906187"}},{"_key":"3c50f9b7269a","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-066f13f23c4b5d4fcfe1dd66d14f2b7de440d3fd-1728x2160-webp","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1084400436","url":"/ext/vimeo-img/2015808079.jpg"},"video":"/ext/video/1084400436-1440p.mp4","videoAdaptive":null,"vimeoId":"1084400436"}},{"_key":"35dff4f9df97","_type":"workDouble45","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-a48dd9f5bc93c81db99f400f2cba5b629891bc26-1728x2160-webp","_type":"reference"}},"mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1082961602","url":"/ext/vimeo-img/2014058196-fd2dc05f5d7b049ea37f73b2fbeb88b01869d8848e3efc3f1169c80388da598b-d.jpg"},"video":"/ext/video/1082961602-1080p.mp4","videoAdaptive":null,"vimeoId":"1082961602"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-a48dd9f5bc93c81db99f400f2cba5b629891bc26-1728x2160-webp","_type":"reference"}},"mediaType":"image"}}]},"orderRank":"0|10000y:r","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"freshcap-mushrooms"},"thumbnailContent":{"_type":"media","mediaType":"video","thumbnail":{"alt":"Thumbnail for Vimeo video 1083693863","url":"/ext/vimeo-img/2014949803-7b394fff0192f58e8e337141b1c4803d7725b895c269bdc10938a48f9916059a-d.jpg"},"video":"/ext/video/1083700231-720p.mp4","videoAdaptive":null,"vimeoId":"1083700231"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-fbd476bb8bc17d66f93555eda0fc0a4923f43af7-3200x1800-jpg","_type":"reference"}},"mediaType":"image"},"thumbnailExcerpt":"Turning a local mushroom brand into an industry leader.","title":"FreshCap Mushrooms","workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ebeae9"},"heroMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-fbd476bb8bc17d66f93555eda0fc0a4923f43af7-3200x1800-jpg","_type":"reference"}},"mediaType":"image"},"sectionContent":[{"_key":"257c265ab0e8","_type":"block","children":[{"_key":"6b457f90e0cf0","_type":"span","marks":[],"text":"FreshCap is on a mission to bring medicinal mushroom supplements to the world. We developed a distinct identity that helped take the brand from a small supplier to an 8-figure industry leader."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand Identity","Packaging","Web Design","Amazon A+"],"websiteURL":"https://freshcap.com/"},"workModules":[{"_key":"6ede6c8355b3","_type":"workDoubleImage","leftMedia":{"_type":"media","mediaType":"video","video":"/ext/video/677839275-720p.mp4"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/677826950-720p.mp4","vimeoId":"677839275"}},{"_key":"69c23d9e73cd","_type":"workTextBlock","content":[{"_key":"2a9a4eed6b18","_type":"block","children":[{"_key":"166534fe1d520","_type":"span","marks":[],"text":"From the start we knew that FreshCap was going to be something special. The brand had to be functional and informative, but we also saw an opportunity to make a splash with something bold and unexpected. Our collaborative approach allowed the founders' personalities to shine through, guiding us through the fantastic world of fungi to create something energetic, authentic, and with tons of personality."}],"markDefs":[],"style":"normal"}],"title":"Building a functional foundation"},{"_key":"6d7b9e368e72","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-68d40479c37a178f91fc515eff5de7a589e94927-1580x1581-jpg","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-d19f718a0e5656bec56c9c2b36e797a1cdc8e5d0-1580x1581-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"92cf560637d7","_type":"workTextBlock","content":[{"_key":"e373ffcada33","_type":"block","children":[{"_key":"28ca3602f5ee0","_type":"span","marks":[],"text":"Search for Functional Mushrooms on Amazon and you'll be inundated by a never ending wall of brown, black, and beige. By contrast, our colour and typography choices were made to reflect the various mushroom species, while steering clear of anything too outwardly muddy. Organic shapes and bold eye-catching visual treatments combine to create a brand that can't help but draw you in. \n\nBonus? We got to discover the awesome world of functional mushrooms for ourselves. We're now full-time fungi fans at Gimetry Studio HQ."}],"markDefs":[],"style":"normal"}],"title":"The FreshCap difference"},{"_key":"d4aa9dbdae04","_type":"workSingleImage","media":{"_type":"media","mediaType":"video","video":"/ext/video/677826896-1440p.mp4","videoAdaptive":null}},{"_key":"f4c8bc0e5721","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-6758dd0396dd5b29796ce9070d41ea4a99614e2a-1562x2000-jpg","_type":"reference"}},"mediaType":"video","video":"/ext/video/684468598-1080p.mp4","videoAdaptive":null},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-6ab00df819c687ced45283325384116906da63b6-1580x1581-jpg","_type":"reference"}},"mediaType":"image"}}]},"params":{"slug":"freshcap-mushrooms"},"globalSettings":{"_createdAt":"2024-10-22T20:44:16Z","_id":"globalSettings","_rev":"6p8vZffvPAFD6E6aSNtKo2","_type":"globalSettings","_updatedAt":"2025-04-24T03:14:08Z","footer":{"email":"yuxuen1993@gmail.com","infoPages":[{"_key":"841d1d64f5ea","_type":"pageLink","path":"/careers","title":"Collaborate"},{"_key":"3ffc11fd5737","_type":"pageLink","path":"/contact","title":"Contact Us"}],"phoneNumber":"+60 11-6368 3842","socials":[]}},"draftMode":false,"seo":{"title":"FreshCap Mushrooms — Gimetry Studio","description":"","image":"","keywords":"","schemaMarkup":null},"token":""},"__N_SSG":true}