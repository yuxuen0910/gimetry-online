t":["Brand Strategy","Brand Identity","Packaging","Web Design","Amazon A+","Copywriting"],"websiteURL":"https://fresh-nutrition.com"},"workModules":[{"_key":"5985e90f5922","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","alt":"FN Process","asset":{"_ref":"image-79ad4fb0e5b72665fc4f84703c3b54d09095546a-1580x1580-png","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1013338794-2160p.mp4","videoAdaptive":null}},{"_key":"b53b43167316","_type":"workTextBlock","content":[{"_key":"67144170b1f7","_type":"block","children":[{"_key":"97f2dcaf60770","_type":"span","marks":[],"text":"After seeing strong sales during the vitamin-fuelled Covid days, Fresh Nutrition’s market footprint had started to plateau. They had a strong Amazon presence and great product. But a fragmented and confusing brand with little creative oversight meant that customer acquisition was dropping off. It was time for a refresh."}],"markDefs":[],"style":"normal"}],"title":"Going back to basics"},{"_key":"6b6560488d54","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","alt":"FN Product with oranges","asset":{"_ref":"image-b971e6d0b6750bed0d3108fbdade04e043bdebfa-1580x1580-png","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","alt":"FN Design book","asset":{"_ref":"image-bd3978b94e62687e39f74d63204e30168778f4e4-1580x1580-png","_type":"reference"}},"mediaType":"image"}},{"_key":"bfae9ced2d90","_type":"workTextBlock","content":[{"_key":"69fd2390cf58","_type":"block","children":[{"_key":"b1a29bb45f9b0","_type":"span","marks":[],"text":"Utilizing our embedded partnership process, the Gimetry Studio team led Fresh Nutrition through a comprehensive repositioning and brand overhaul — including a complete rebuild of their AI Automation website. After aligning on a strategy, we rolled out copywriting, design, packaging and marketing strategy for 35+ flagship supplement products."}],"markDefs":[],"style":"normal"}],"title":"A comprehensive rebrand"},{"_key":"d1967fc17747","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","alt":"FN Family Photo","asset":{"_ref":"image-cc57edbd8aeb77bbc2694d176a02f33bd0eb9e35-3200x1800-png","_type":"reference"}},"mediaType":"image"}},{"_key":"ea1525d0b0be","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","alt":"FN Tote","asset":{"_ref":"image-404bdadf2da3827a6809cc4e8f039fe54a1d2a0a-2160x2159-jpg","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","mediaType":"video","video":"/ext/video/1013338821-2160p.mp4","videoAdaptive":null}},{"_key":"f4a7d486daec","_type":"workTextBlock","content":[{"_key":"f2fff20b6e9d","_type":"block","children":[{"_key":"8dbc72d52f8c0","_type":"span","marks":[],"text":"The rebrand gave the Fresh Nutrition team an ownable brand identity, built around their core strengths of direct-to-you simplicity and clarity. The scalable design system helps products stand out in a crowded marketplace, and a close working relationship between Gimetry Studio and product managers continues to enable rapid product innovation and quick go-to-market rollouts, helping the brand stay ahead of the competition."}],"markDefs":[],"style":"normal"},{"_key":"c5bfce26f991","_type":"block","children":[{"_key":"8fe70b9879760","_type":"span","marks":[],"text":"Now that’s Fresh."}],"markDefs":[],"style":"normal"},{"_key":"e18b987837a8","_type":"block","children":[{"_key":"2de9dce466c80","_type":"span","marks":[],"text":"\n"}],"markDefs":[],"style":"normal"}],"title":"Bringing it all together"},{"_key":"8cf21a10023f","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","alt":"From us to you","asset":{"_ref":"image-b2fb023f4d93e81ddeb78a2976e1d86855d38c78-3200x1800-png","_type":"reference"}},"mediaType":"image"}}]},"orderRank":"0|10001h:","ourProcess":{"hideProcessButton":true},"slug":{