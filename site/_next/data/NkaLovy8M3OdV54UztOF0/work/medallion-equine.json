{"pageProps":{"work":{"_createdAt":"2025-02-18T22:54:35Z","_id":"95c3afa7-8913-4462-b1d4-2e46110d462d","_rev":"tTlXFWaLzsE9XjbfIDpih8","_type":"work","_updatedAt":"2026-07-06T20:17:39Z","nextProject":{"_createdAt":"2025-02-14T23:37:28Z","_id":"8fc67b21-d878-41ea-b9e5-ef237a5424a0","_rev":"tTlXFWaLzsE9XjbfIDq32a","_system":{"base":{"id":"8fc67b21-d878-41ea-b9e5-ef237a5424a0","rev":"OpsZPE53kk3Lpa0RAW5qmW"}},"_type":"work","_updatedAt":"2026-07-06T20:20:00Z","nextProject":{"_ref":"62e51a70-e26d-4d32-abac-5269b4d8964c","_type":"reference"},"orderRank":"0|10001j:v","ourProcess":{"hideProcessButton":true},"slug":{"_type":"slug","current":"tools-for-change"},"thumbnailContent":{"_type":"media","mediaType":"video","video":"/ext/video/1083700402-720p.mp4","videoAdaptive":null,"vimeoId":"1083700402"},"thumbnailCover":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-060972ce07a84519ae9318c6d6b8b01c91c313bb-3200x1738-jpg","_type":"reference"}},"mediaType":"image"},"thumbnailExcerpt":"A safe space for the creative community.","title":"Tools For Change","workHeroSection":{"backgroundColor":{"label":"Custom","value":"#ebeae9"},"heroMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-060972ce07a84519ae9318c6d6b8b01c91c313bb-3200x1738-jpg","_type":"reference"}},"mediaType":"image"},"sectionContent":[{"_key":"8ce6db02eba1","_type":"block","children":[{"_key":"698cd744fc190","_type":"span","marks":[],"text":"Creating is human. But for more than half of us, building, learning, making and crafting has historically been less accessible. Tools For Change is here to change that by engineering a more equitable future."}],"markDefs":[],"style":"normal"}],"servicesList":["Brand Identity","Print Design","Illustration"]},"workModules":[{"_key":"3def6116e2a5","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-f108acb65bf0432f771c08f8d02286f2b80975dd-1600x1600-jpg","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-17ba10e54966ab1cd5ce3036435626e14a60397e-1600x1600-jpg","_type":"reference"}},"mediaType":"image"}},{"_key":"f16914202494","_type":"workTextBlock","content":[{"_key":"10cc861574b4","_type":"block","children":[{"_key":"7f2f0c15d17c0","_type":"span","marks":[],"text":"Tools For Change is a community program that celebrates and empowers women and underrepresented creators of all kinds. Our talented female designers took the lead on this project, creating a playful, friendly and safe brand space that encourages learning and discovery."}],"markDefs":[],"style":"normal"}],"title":"Building something better"},{"_key":"01857bd72236","_type":"workDoubleImage","leftMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-76850560eddcc664086065ef37782277977e6284-1600x1600-jpg","_type":"reference"}},"mediaType":"image"},"rightMedia":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-3b1cc070426d2546cf441243098379c531cb1a26-1801x1800-png","_type":"reference"}},"mediaType":"video","video":"/ext/video/770937149-1080p.mp4","videoAdaptive":null}},{"_key":"f675d5eae764","_type":"workTextBlock","content":[{"_key":"f0dcb57e0368","_type":"block","children":[{"_key":"29daa0f699c70","_type":"span","marks":[],"text":"We wanted to inject maker culture into all aspects of the brand. Modular shapes, rough textures, dynamic typography and imperfect graphic flourishes help each touchpoint feel tactile and alive — inviting you into the creation process."}],"markDefs":[],"style":"normal"},{"_key":"8f9ed4709255","_type":"block","children":[{"_key":"1f01e691b9fc","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"title":"A handcrafted feel"},{"_key":"b17bd788fa1c","_type":"workSingleImage","media":{"_type":"media","image":{"_type":"image","asset":{"_ref":"image-b0641cf79a12e61e4ac8938494b64a427cce827b-3200x1200-jpg","_type":"reference"}},"mediaType":"video","video":"/ext/vi