70590","_type":"span","marks":[],"text":"Here is where ideas take shape. We explore directions in the open, share early and often, and keep the ones that survive contact with your business."}],"markDefs":[],"style":"normal"}],"images":[{"_id":null,"_key":"39e6e06ab427","_type":"video","asset":null,"video":"/ext/video/1081893221-1440p.mp4","vimeoId":"1081893221"},{"_id":null,"_key":"563c7f1d52b6","_type":"video","asset":null,"thumbnail":{"alt":"Thumbnail for Vimeo video 1081893256","url":"/ext/vimeo-img/2012768434-5ac8241cbdd292f82a707b90d987f1e7c0ca9d50e955d1edf39e56a8c067882c-d.jpg"},"video":"/ext/video/1081893256-720p.mp4","vimeoId":"1081893256"},{"_id":null,"_key":"7e41cd3578ce","_type":"video","asset":null,"thumbnail":{"alt":"Thumbnail for Vimeo video 1081893315","url":"/ext/vimeo-img/2012768472-b8f6b2d2df3459ff8d964af970f9edaa1f8d39f0adcbc057d3c8c5fb5ed01493-d.jpg"},"video":"/ext/video/1081893315-1440p.mp4","vimeoId":"1081893315"},{"_id":null,"_key":"02cf42d1c99c","_type":"video","asset":null,"thumbnail":{"alt":"Thumbnail for Vimeo video 1081893332","url":"/ext/vimeo-img/2012768519-0f26c67f5d5de8f0ba268345f0175d9dd517e47396d7444b0d7eaa20b2c8e30d-d.jpg"},"video":"/ext/video/1081893332-1440p.mp4","vimeoId":"1081893332"}],"title":"Concept"},{"_key":"c04473fed7d1de3c6ac8b0752d28fa64","content":[{"_key":"4c7e3ee3052f","_type":"block","children":[{"_key":"84d05b6f70f00","_type":"span","marks":[],"text":"Then we build it properly. Identity systems, sites and motion, delivered as files and components your team can actually use, with the rules written down."}],"markDefs":[],"style":"normal"}],"images":[{"_id":null,"_key":"df67dabbdc94","_type":"video","asset":null,"thumbnail":{"alt":"Thumbnail for Vimeo video 1082006666","url":"/ext/vimeo-img/2012905717-a3af34474f1106141cbce1e0d0fc90ef7ae8c33bd69cb37717e4feedb990c7f1-d.jpg"},"video":"/ext/video/1082006666-1440p.mp4","vimeoId":"1082006666"},{"_id":null,"_key":"db446ec60be0","_type":"video","asset":null,"thumbnail":{"alt"