{"pageProps":{"studio":{"_createdAt":"2024-10-22T22:16:56Z","_id":"studioPage","_rev":"ffOA5dJsB1rud0qrXH52Zs","_system":{"base":{"id":"studioPage","rev":"B0GdY1xUnzEygnDQoxvPVc"}},"_type":"studioPage","_updatedAt":"2026-06-05T22:39:28Z","footerGif":{"_type":"image","asset":{"_ref":"image-66d519bf5d5b61745dffe1d292e17309e23fb4d5-497x280-gif","_type":"reference"}},"hero":{"heroContent":[{"_key":"4404e5c07317","_type":"block","children":[{"_key":"ac28a57664e70","_type":"span","marks":[],"text":"We are a brand, web and motion design studio based in Johor Bahru. We work with companies at the point where what they have stopped matching what they have become, and build the identity, the site and the motion that catch them up."}],"markDefs":[],"style":"normal"},{"_key":"6b3a587cc4cc","_type":"block","children":[{"_key":"8dcea4775277","_type":"span","marks":[],"text":"Johor Bahru sits an hour from Singapore, and that shapes how we work. Projects run across Malaysia and Singapore and further afield, often with teams in different places, so we keep the process quick, direct and easy to follow."}],"markDefs":[],"style":"normal"},{"_key":"b2cb7eb2a250","_type":"block","children":[{"_key":"020762100620","_type":"span","marks":[],"text":"The work spans robotics and AI infrastructure, fintech, industrial services, a football club and a theme park campaign. Different worlds, one method: find what is already true, then make it impossible to miss."}],"markDefs":[],"style":"normal"}],"heroImages":[{"_key":"f07b08cdad5d","_type":"image","alt":"Gimetry Studio discovery session","asset":{"_ref":"image-e1aaa254563986073f0907b5ffed23e2e1042e28-3400x4248-webp","_type":"reference"}},{"_key":"d8ff0004c324","_type":"image","alt":"Brand identity production work in progress","asset":{"_ref":"image-b705fe0862e899fb36a2bbf28f73f65d6702ea61-3400x4256-webp","_type":"reference"}},{"_key":"b964ba0ab17b","_type":"image","alt":"Packaging and print work on the studio table","asset":{"_ref":"image-80313d13c3159ea516cd06b9fe3358f5dc6cad0a-3000x3748-webp","_type":"reference"}},{"_key":"49a47bacca71","_type":"image","alt":"Motion design work on screen","asset":{"_ref":"image-abc07c3b23d653fb9496be2f0816daf5f110ce41-3000x3750-webp","_type":"reference"}},{"_key":"8a9c3caa3bc1","_type":"image","alt":"Studio work session","asset":{"_ref":"image-4c859182ce160ac08bdaf84c4b924ea74cdead83-3400x4260-webp","_type":"reference"}}],"heroText":"Where Ideas Take Shape","subTitle":"About Us"},"hiring":{"ctaLabel":"Start a project","description":[{"_key":"78ed93ab3d33","_type":"block","children":[{"_key":"0388904def7d0","_type":"span","marks":[],"text":"If you have a brand, a launch or a campaign that needs to look like it means it, tell us about it. We take on a small number of projects at a time so each one gets the people who designed it, start to finish."}],"markDefs":[],"style":"normal"}],"subtitle":"Get in touch","title":"Let’s work together"},"metaDescription":"Gimetry Studio is a brand, web and motion design studio in Johor Bahru, Malaysia, working with clients across Malaysia, Singapore and further afield.","metaTitle":"About — Gimetry Studio","ogImage":{"_type":"image","asset":{"_ref":"image-96e911b7bebeaf320ae15e8f2a195f63cd525b3d-2400x1260-png","_type":"reference"}},"ourPhilosophy":{"philosophyContent":[{"_key":"b408c3bffe6e","_type":"block","children":[{"_key":"750df254452e0","_type":"span","marks":[],"text":"We think design earns its keep by making things clearer, not just better looking. So we ask the awkward questions early, build systems rather than one-offs, and hand over something you can grow into instead of something you will outgrow."}],"markDefs":[],"style":"normal"}],"subtitle":"Our philosophy"},"ourProcess":{"processSteps":[{"_key":"f5cd02b04d15","content":[{"_key":"c64c3ba9e990","_type":"block","children":[{"_key":"bd8f24a567710","_type":"span","marks":[],"text":"Every project starts with questions. Who is this actually for, what has to be true on day one, what breaks at scale. We would rather find the awkward answers now than design around them later."}],"markDefs":[],"style":"normal"}],"images":[{"_id":null,"_key":"1a2bc67b044c","_type":"image","alt":"UNBOX™","asset":{"_createdAt":"2025-05-06T16:24:25Z","_id":"image-8e7cd8f163d65ebf4dce46953a33cb7f48211367-2792x2793-png","_rev":"9swHq9cN7b61rkNNsRSDBH","_type":"sanity.imageAsset","_updatedAt":"2025-05-06T16:24:25Z","assetId":"8e7cd8f163d65ebf4dce46953a33cb7f48211367","extension":"png","metadata":{"dimensions":{"height":2793,"width":2792}},"mimeType":"image/png","originalFilename":"Discovery 01_Photo.png","path":"images/7nifcbro/production/8e7cd8f163d65ebf4dce46953a33cb7f48211367-2792x2793.png","sha1hash":"8e7cd8f163d65ebf4dce46953a33cb7f48211367","size":14499161,"uploadId":"jQPRF0porVRN5dAINL9oCilb9ORmRuJi","url":"/ext/sanity/images/7nifcbro/production/8e7cd8f163d65ebf4dce46953a33cb7f48211367-2792x2793.png"}},{"_id":null,"_key":"15eb32240e23","_type":"video","asset":null,"thumbnail":{"alt":"Thumbnail for Vimeo video 1081892655","url":"/ext/vimeo-img/2012767685-26f5fad18d8c2cd87f4564171039e211ff285796718938b4f36669a8bdf5ff08-d.jpg"},"video":"/ext/video/1081892655-1440p.mp4","vimeoId":"1081892655"},{"_id":null,"_key":"a6d6162b9715","_type":"video","asset":null,"thumbnail":{"alt":"Thumbnail for Vimeo video 1081892671","url":"/ext/vimeo-img/2012767688-cea4221ae86bbba13f0ab5032c8a8f0948e2dd23cf2c36a93533d14219c08bae-d.jpg"},"video":"/ext/video/1081892671-1440p.mp4","vimeoId":"1081892671"},{"_id":null,"_key":"d5a05037ba4c","_type":"image","alt":"Man looking at list","asset":{"_createdAt":"2025-05-06T23:18:07Z","_id":"image-16d6b3e7b3e11e226be24ce7eebce90e0f9650df-2493x2493-png","_rev":"eWIeywbC18UQPXiGx2dgV0","_type":"sanity.imageAsset","_updatedAt":"2025-05-06T23:18:07Z","assetId":"16d6b3e7b3e11e226be24ce7eebce90e0f9650df","extension":"png","metadata":{"dimensions":{"height":2493,"width":2493}},"mimeType":"image/png","originalFilename":"Discovery 04_Photo.png","path":"image